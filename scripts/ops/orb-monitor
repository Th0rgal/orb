#!/usr/bin/env python3
"""orb-monitor: one small health check for an Orb Core host.

Runs from a systemd timer. Each run evaluates a fixed list of checks and
compares the set of open problems with the previous run; it sends one message
only when a problem opens or clears. Everything it reads is local (HTTP on
loopback, SQLite read-only, nginx access log, systemd), so it keeps working
when Core itself is unhealthy.

Config comes from the environment (see deploy/systemd/orb-monitor.service):
  ORB_MONITOR_STATE         state file (default /var/lib/orb-monitor/state.json)
  ORB_MONITOR_SIGNAL_URL    POST endpoint taking {"recipient","message"}; unset = journal only
  ORB_MONITOR_SIGNAL_RECIPIENT, ORB_MONITOR_SIGNAL_TOKEN
  ORB_MONITOR_MISSIONS_DB, ORB_MONITOR_COMPUTE_DB, ORB_MONITOR_NGINX_LOG
"""
import datetime, json, os, re, sqlite3, subprocess, sys, time, urllib.request

ENV = os.environ.get
STATE = ENV("ORB_MONITOR_STATE", "/var/lib/orb-monitor/state.json")
MISSIONS_DB = ENV("ORB_MONITOR_MISSIONS_DB", "/root/.sandboxed-sh/missions/missions-prod.db")
COMPUTE_DB = ENV("ORB_MONITOR_COMPUTE_DB", "/root/.sandboxed-sh/managed_compute.db")
NGINX_LOG = ENV("ORB_MONITOR_NGINX_LOG", "/var/log/nginx/access.log")
SERVICES = {"prod": 3000, "dev": 3002}
UNIT_PATTERN = re.compile(r"orb|sandboxed|paloma|hermes|cli-proxy|lean-mesh")
STALL_MINUTES = 30
NOW = time.time()


def ro(db):
    return sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)


def check_health(problems, info):
    for name, port in SERVICES.items():
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=5) as r:
                body = json.load(r)
            if body.get("status") != "ok":
                problems[f"health:{name}"] = f"{name} Core health is {body.get('status')!r}"
            info[f"build:{name}"] = body.get("build", "?")
        except Exception as exc:
            problems[f"health:{name}"] = f"{name} Core does not answer /api/health ({type(exc).__name__})"


def check_proxy(problems):
    """Model proxy errors over the last 10 minutes of the nginx access log."""
    try:
        size = os.path.getsize(NGINX_LOG)
        with open(NGINX_LOG, "rb") as f:
            f.seek(max(0, size - 2_000_000))
            lines = f.read().decode("utf-8", "replace").splitlines()[1:]
    except OSError:
        return
    cutoff = NOW - 600
    total = bad5 = bad4 = 0
    for line in lines:
        m = re.search(r'\[([^\]]+)\] "\S+ (/v1/\S*) [^"]*" (\d{3}) ', line)
        if not m:
            continue
        try:
            ts = datetime.datetime.strptime(m.group(1), "%d/%b/%Y:%H:%M:%S %z").timestamp()
        except ValueError:
            continue
        if ts < cutoff:
            continue
        total += 1
        code = int(m.group(3))
        bad5 += code >= 500
        bad4 += code in (400, 404)
    if bad5 >= 20:
        problems["proxy:5xx"] = f"model proxy returned {bad5} 5xx in 10 min ({total} requests)"
    if bad4 >= 30:
        problems["proxy:4xx"] = f"model proxy rejected {bad4} requests (400/404) in 10 min; likely an unknown model alias"


def check_missions(problems):
    """Missions marked active with no running job and no event for STALL_MINUTES."""
    try:
        con = ro(MISSIONS_DB)
        cutoff = datetime.datetime.fromtimestamp(NOW - STALL_MINUTES * 60, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
        rows = con.execute(
            "SELECT m.id, m.title FROM missions m WHERE m.status='active' AND m.updated_at < ? "
            "AND m.updated_at LIKE '20%' "
            "AND NOT EXISTS (SELECT 1 FROM remote_node_jobs j WHERE j.mission_id=m.id AND j.state IN ('running','queued','pending') )",
            (cutoff,),
        ).fetchall()
        con.close()
    except sqlite3.Error as exc:
        problems["db:missions"] = f"cannot read missions DB ({exc})"
        return
    for mid, title in rows:
        problems[f"stalled:{mid[:8]}"] = f"mission '{(title or '')[:40]}' ({mid[:8]}) is marked active but has no running job for {STALL_MINUTES}+ min"


def check_machines(problems):
    """Managed VMs past expiry, or alive while their owner mission is not working."""
    try:
        con = ro(COMPUTE_DB)
        rows = con.execute(
            "SELECT id, size, owner_mission, expires_at_sec FROM managed_machines "
            "WHERE status='ready' AND provider_id<>''"
        ).fetchall()
        con.close()
    except sqlite3.Error as exc:
        problems["db:compute"] = f"cannot read compute DB ({exc})"
        return
    owners = {}
    try:
        con = ro(MISSIONS_DB)
        for mid, st in con.execute("SELECT id, status FROM missions WHERE id IN (%s)" % ",".join("?" * len(rows)), [r[2] for r in rows]):
            owners[mid] = st
        con.close()
    except sqlite3.Error:
        pass
    for mid, size, owner, exp in rows:
        if exp and exp < NOW:
            problems[f"vm-expired:{mid[:8]}"] = f"VM {mid[:8]} ({size}) expired {int((NOW - exp) / 60)} min ago and is still marked ready"
        elif owners.get(owner) in ("completed", "failed", "cancelled", "interrupted"):
            problems[f"vm-orphan:{mid[:8]}"] = f"VM {mid[:8]} ({size}) is alive but its mission {owner[:8]} is {owners[owner]}"
        elif exp and exp - NOW < 20 * 60:
            problems[f"vm-expiring:{mid[:8]}"] = f"VM {mid[:8]} ({size}, mission {owner[:8]}) expires in {int((exp - NOW) / 60)} min"


def check_units(problems):
    out = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        unit = line.split()[0] if line.split() else ""
        if UNIT_PATTERN.search(unit):
            problems[f"unit:{unit}"] = f"systemd unit {unit} is failed"


def check_builds(problems):
    out = subprocess.run(["ps", "-eo", "etimes=,comm="], capture_output=True, text=True).stdout
    longest = max([int(l.split()[0]) for l in out.splitlines() if l.split()[1:] == ["lake"]] or [0])
    if longest > 90 * 60:
        problems["build:long"] = f"a lake build has been running for {longest // 60} min"


def notify(text):
    print(text)
    url = ENV("ORB_MONITOR_SIGNAL_URL", "").strip()
    if not url:
        return
    headers = {"Content-Type": "application/json"}
    if ENV("ORB_MONITOR_SIGNAL_TOKEN"):
        headers["Authorization"] = "Bearer " + ENV("ORB_MONITOR_SIGNAL_TOKEN").strip()
    body = json.dumps({"recipient": ENV("ORB_MONITOR_SIGNAL_RECIPIENT", "").strip(), "message": text}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method="POST"), timeout=8).read()
    except Exception as exc:
        print(f"notify failed: {type(exc).__name__}", file=sys.stderr)


def main():
    problems, info = {}, {}
    for check in (check_health, check_proxy, check_missions, check_machines, check_units, check_builds):
        try:
            check(problems, info) if check is check_health else check(problems)
        except Exception as exc:  # a broken check is itself a problem, never a crash
            problems[f"check:{check.__name__}"] = f"{check.__name__} crashed: {type(exc).__name__}: {exc}"
    try:
        prev = json.load(open(STATE))
    except (OSError, ValueError):
        prev = None
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    json.dump({"problems": problems, "info": info, "at": int(NOW)}, open(STATE + ".tmp", "w"), indent=1)
    os.replace(STATE + ".tmp", STATE)
    if "--print" in sys.argv:
        print(json.dumps({"problems": problems, "info": info}, indent=1))
        return 0
    old = (prev or {}).get("problems", {})
    opened = [v for k, v in problems.items() if k not in old]
    cleared = [v for k, v in old.items() if k not in problems]
    lines = []
    if prev is None:
        lines = [f"[orb-monitor] started; {len(problems)} open problem(s)"] + [f"- {v}" for v in problems.values()]
    else:
        if opened:
            lines += ["[orb-monitor] new:"] + [f"- {v}" for v in opened]
        if cleared:
            lines += ["[orb-monitor] cleared:"] + [f"- {v}" for v in cleared]
        for k in ("build:prod", "build:dev"):
            if (prev.get("info") or {}).get(k) not in (None, info.get(k)) and info.get(k):
                lines.append(f"[orb-monitor] {k.split(':')[1]} now runs build {info[k]}")
    if lines:
        notify("\n".join(lines)[:1800])
    return 0


if __name__ == "__main__":
    sys.exit(main())
