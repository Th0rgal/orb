#!/usr/bin/env python3
"""Converge dev to origin/master through the normal build/test/health deploy gate."""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import urllib.request

TREE = Path(os.environ.get("ORB_DEPLOY_TREE", "/var/tmp/orbcore-lean-build"))
DEPLOY = "/usr/local/sbin/orb-deploy"
LOCK = "/run/lock/orb-dev-autodeploy.lock"


def command(*args, timeout=60):
    return subprocess.run(args, cwd=TREE, check=True, capture_output=True,
                          text=True, timeout=timeout).stdout.strip()


def dev_build():
    try:
        with urllib.request.urlopen("http://127.0.0.1:3002/api/health", timeout=5) as response:
            health = json.load(response)
        if not isinstance(health, dict):
            return ""
        build = health.get("build", "")
        if health.get("status") == "ok" and re.fullmatch(r"[0-9a-f]{9,40}", build):
            return build
    except (OSError, ValueError, TypeError):
        pass
    return ""


def tick():
    # The deployment owns this checkout while building. Never fetch or otherwise
    # touch it until the detached service has finished (manual prod deploys too).
    active = subprocess.run(["systemctl", "is-active", "--quiet", "orb-deploy.service"],
                            check=False, timeout=10, capture_output=True)
    if active.returncode == 0:
        return "deployment already running"
    # Only the existing reviewed repository's master is eligible. No SHA, ref,
    # branch, command, path or service name is accepted from a webhook/request.
    remote = command("git", "remote", "get-url", "origin")
    if remote not in {"https://github.com/Th0rgal/orb.git", "git@github.com:Th0rgal/orb.git"}:
        raise RuntimeError("unexpected deployment repository")
    command("git", "fetch", "--quiet", "origin", "+refs/heads/master:refs/remotes/origin/master")
    sha = command("git", "rev-parse", "--verify", "refs/remotes/origin/master^{commit}")
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise RuntimeError("invalid master commit")
    live = dev_build()
    if live and sha.startswith(live):
        return "dev is current"
    command(DEPLOY, "--detach", sha, "--dev-only", timeout=15)
    return "submitted dev deployment " + sha


def main():
    with open(LOCK, "a", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        try:
            print(tick())
        except (OSError, ValueError, subprocess.SubprocessError, RuntimeError):
            # Never log inherited environment, remote strings, or subprocess
            # stderr: host credentials may appear there. The timer retries.
            raise SystemExit("dev auto-deploy failed; will retry") from None


if __name__ == "__main__":
    main()
