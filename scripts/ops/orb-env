class InvalidConfig(Exception):
    pass


def literal(value):
    """Decode our single-line subset of systemd.syntax(7), without expansion."""
    if value.endswith("\\"):
        raise InvalidConfig("unsupported continuation")
    if value.startswith("'"):
        if len(value) < 2 or not value.endswith("'") or "'" in value[1:-1]:
            raise InvalidConfig("unsupported single quoting")
        return value[1:-1]
    quoted = value.startswith('"')
    if quoted:
        if len(value) < 2 or not value.endswith('"'):
            raise InvalidConfig("unsupported double quoting")
        value = value[1:-1]
    result = ""
    index = 0
    while index < len(value):
        char = value[index]
        if char == '"' and quoted:
            raise InvalidConfig("unsupported double quoting")
        if char == "\\":
            index += 1
            if index == len(value):
                raise InvalidConfig("unsupported escape")
            char = value[index]
            if quoted and char not in '\\"`$':
                result += "\\"
        result += char
        index += 1
    return result


def parse_env(raw):
    """Keep RHS text verbatim; never use shell evaluation or reconstruct values."""
    try:
        source = raw.decode("utf-8")
    except UnicodeError:
        raise InvalidConfig("env file must be UTF-8") from None
    result = {}
    for number, line in enumerate(source.split("\n"), 1):
        line = line.rstrip("\r").strip(" \t")
        if not line or line.startswith(("#", ";")):
            continue
        match = re.fullmatch(r"([A-Za-z_][A-Za-z_0-9]*)[ \t]*=(.*)", line)
        if not match or any(ord(c) < 32 and c != "\t" for c in line):
            raise InvalidConfig(f"unsupported assignment at line {number}")
        key, value = match.groups()
        value = value.strip(" \t")
        if key in result:
            raise InvalidConfig(f"duplicate key {key} at line {number}")
        try:
            literal(value)
        except InvalidConfig:
            raise InvalidConfig(f"unsupported quoting or continuation at line {number}") from None
        result[key] = value
    return result


def ownership(document=None):
    """Operator decisions contain names and source labels, never env values."""
    if document is None:
        document = {"schema_version": 1, "instance_keys": [], "shared_from": {}}
    if (not isinstance(document, dict) or set(document) != {"schema_version", "instance_keys", "shared_from"}
            or type(document["schema_version"]) is not int or document["schema_version"] != 1
            or not isinstance(document["instance_keys"], list)
            or not isinstance(document["shared_from"], dict)):
        raise InvalidConfig("invalid ownership document")
    keys, shared = document["instance_keys"], document["shared_from"]
    def key_name(value):
        return isinstance(value, str) and re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*", value)
    if (not all(key_name(key) for key in keys) or len(set(keys)) != len(keys)
            or not all(key_name(key) and source in ("prod", "dev") for key, source in shared.items())
            or not set(keys) <= (INSTANCE_KEYS | PROD_ONLY_KEYS)
            or not set(shared) <= SHARED_KEYS):
        raise InvalidConfig("invalid or conflicting ownership decisions")
    return {"schema_version": 1, "instance_keys": sorted(keys), "shared_from": dict(sorted(shared.items()))}


def read_ownership(path):
    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise InvalidConfig("duplicate ownership decision")
            result[key] = value
        return result
    try:
        return ownership(json.loads(path.read_bytes(), object_pairs_hook=unique_object))
    except (ValueError, UnicodeError):
        raise InvalidConfig("invalid ownership document") from None


def differences(prod, dev):
    return {key: ("dev_only" if key not in prod else "prod_only" if key not in dev else "different")
            for key in sorted((prod.keys() | dev.keys()) - INSTANCE_KEYS)
            if key not in prod or key not in dev or literal(prod[key]) != literal(dev[key])}


def inventory(prod, dev):
    changed = differences(prod, dev)
    return {"differences": changed,
            "classifications": {key: ("shared" if key in SHARED_KEYS else "instance-owned" if key in INSTANCE_KEYS
                                      else "prod-only-allowed" if key in PROD_ONLY_KEYS else "unclassified")
                                for key in sorted(prod.keys() | dev.keys())},
            "unknown_keys": sorted((prod.keys() | dev.keys()) - KNOWN_KEYS),
            "ownership": {"schema_version": 1, "instance_keys": [],
                          "shared_from": {key: "review" for key in changed if key in SHARED_KEYS}}}


def check(base, overlay, policy=None):
    policy = ownership(policy)
    instance_keys = INSTANCE_KEYS | PROD_ONLY_KEYS
    unknown = (base.keys() | overlay.keys()) - KNOWN_KEYS
    if unknown:
        raise InvalidConfig("unclassified environment keys: " + ", ".join(sorted(unknown)))
    if literal(overlay.get("ORB_INSTANCE", "")) == "dev" and overlay.keys() & PROD_ONLY_KEYS:
        raise InvalidConfig("prod-only authority configured on dev: " + ", ".join(sorted(overlay.keys() & PROD_ONLY_KEYS)))
    overlap = base.keys() & overlay.keys()
    if overlap:
        raise InvalidConfig("overlay redefines base keys: " + ", ".join(sorted(overlap)))
    misplaced = (base.keys() & instance_keys) | (overlay.keys() - instance_keys)
    if misplaced:
        raise InvalidConfig("keys in the wrong layer: " + ", ".join(sorted(misplaced)))
    missing = REQUIRED - overlay.keys()
    if missing:
        raise InvalidConfig("missing instance keys: " + ", ".join(sorted(missing)))
    if any(not literal(overlay[key]) for key in REQUIRED):
        raise InvalidConfig("required instance keys must not be empty")
    if literal(overlay["ORB_INSTANCE"]) not in {"prod", "dev"}:
        raise InvalidConfig("ORB_INSTANCE must be prod or dev")


def split_envs(prod, dev, policy=None):
    policy = ownership(policy)
    instance_keys = INSTANCE_KEYS | PROD_ONLY_KEYS
    shared_from = policy["shared_from"]
    unclassified = (prod.keys() | dev.keys()) - KNOWN_KEYS
    if unclassified:
        raise InvalidConfig("unclassified environment keys: " + ", ".join(sorted(unclassified)))
    unknown = (set(policy["instance_keys"]) | shared_from.keys()) - (prod.keys() | dev.keys())
    if unknown:
        raise InvalidConfig("ownership names absent from both inputs: " + ", ".join(sorted(unknown)))
    for key, source in shared_from.items():
        if key not in (prod if source == "prod" else dev):
            raise InvalidConfig("selected shared source is missing key: " + key)
    common = (prod.keys() | dev.keys()) - instance_keys
    conflicts = set(differences(prod, dev)) - instance_keys - shared_from.keys()
    if conflicts:
        raise InvalidConfig("resolve shared setting differences before migration: " + ", ".join(sorted(conflicts)))
    base = {key: (dev if shared_from.get(key) == "dev" else prod)[key] for key in common}
    overlays = []
    for name, source in (("prod", prod), ("dev", dev)):
        overlay = {key: value for key, value in source.items() if key in instance_keys}
        if "ORB_INSTANCE" in overlay and literal(overlay["ORB_INSTANCE"]) != name:
            raise InvalidConfig("legacy ORB_INSTANCE disagrees with its instance")
        overlay["ORB_INSTANCE"] = name
        check(base, overlay, policy)
        overlays.append(overlay)
    # Sharing these would silently defeat instance isolation. Do not mint or
    # change credentials here: the operator resolves conflicts in the source.
    for key in ("PORT", "WORKING_DIR", "JWT_SECRET", "DASHBOARD_PASSWORD"):
        if key in prod and key in dev and literal(prod[key]) == literal(dev[key]):
            raise InvalidConfig(f"instances must have distinct {key}")
    return base, *overlays


def write_private(path, raw):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


def render(settings):
    return ("".join(f"{key}={settings[key]}\n" for key in sorted(settings))).encode("utf-8")


def migrate(prod_path, dev_path, output, apply=False, policy=None):
    prod_raw, dev_raw = prod_path.read_bytes(), dev_path.read_bytes()
    policy = ownership(policy)
    base, prod, dev = split_envs(parse_env(prod_raw), parse_env(dev_raw), policy)
    if output.exists():
        raise InvalidConfig("output directory already exists; refusing to overwrite it")
    if not apply:
        return
    # Exclusive mkdir means reruns never replace a previous configuration or
    # its backups. No live input or service is modified, even on failure.
    output.mkdir(mode=0o700)
    try:
        (output / "backups").mkdir(mode=0o700)
        write_private(output / "backups/prod.env", prod_raw)
        write_private(output / "backups/dev.env", dev_raw)
        write_private(output / "ownership.json", (json.dumps(policy, indent=2) + "\n").encode())
        for name, settings in (("core", base), ("prod", prod), ("dev", dev)):
            write_private(output / f"{name}.env", render(settings))
    except BaseException:
        shutil.rmtree(output)
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    verify = commands.add_parser("check")
    verify.add_argument("--base", type=Path, required=True)
    verify.add_argument("--overlay", type=Path, required=True)
    migration = commands.add_parser("migrate")
    migration.add_argument("--prod", type=Path, required=True)
    migration.add_argument("--dev", type=Path, required=True)
    migration.add_argument("--output", type=Path, required=True)
    migration.add_argument("--ownership", type=Path, help="reviewed names-only ownership JSON from inventory")
    report = commands.add_parser("inventory", help="print names and a conservative ownership template, never values")
    report.add_argument("--prod", type=Path, required=True)
    report.add_argument("--dev", type=Path, required=True)
    migration.add_argument("--apply", action="store_true", help="write files; default only validates")
    args = parser.parse_args()
    try:
        if args.command == "check":
            policy_path = args.base.parent / "ownership.json"
            policy = read_ownership(policy_path) if policy_path.exists() else None
            check(parse_env(args.base.read_bytes()), parse_env(args.overlay.read_bytes()), policy)
        elif args.command == "inventory":
            print(json.dumps(inventory(parse_env(args.prod.read_bytes()), parse_env(args.dev.read_bytes())), indent=2))
            return 0
        else:
            policy = read_ownership(args.ownership) if args.ownership else None
            migrate(args.prod, args.dev, args.output, args.apply, policy)
        print("Core env check passed" if args.command == "check" else
              "Migration written with both backups" if args.apply else "Migration validated (no files written)")
        return 0
    except (InvalidConfig, OSError) as error:
        # OSError paths can be operator supplied, but never contain file data.
        print(f"orb-env: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
