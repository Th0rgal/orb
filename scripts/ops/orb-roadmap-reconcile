#!/usr/bin/env python3
"""orb-roadmap-reconcile: keep the Orb roadmap moving without a controller model.

Runs from a systemd timer on the Core host. Each run is stateless apart from a
small nudge ledger: it reads the desired state (the roadmap file on master),
the observed state (GitHub pull requests and CI on master, roadmap missions in
Core's database) and takes the few actions that close the gap:

  * a queued row whose needs are done and that has no live worker gets one;
  * a worker that went idle without merging is resumed once, then replaced
    once, then reported to the Inbox as needing a decision;
  * when master CI is red, only the fix row runs.

A row is done when its roadmap state says so or when a pull request whose
title ends with "(<row id>)" has merged. Workers merge their own PR on green
CI (rule M); this script never merges, deploys or touches a mission it did not
start (missions are recognised by track "roadmap-<row id>").

Config (environment, see deploy/systemd/orb-roadmap-reconcile.service):
  ORB_ROADMAP_STATE        nudge ledger (default /var/lib/orb-roadmap/state.json)
  ORB_ROADMAP_MAX_WORKERS  live workers at once (default 3)
  ORB_ROADMAP_MODELS       worker models, one per attempt, comma-separated
                           (default openai/gpt-6-astra,anthropic/claude-fable-5-2)
  ORB_ROADMAP_INBOX_MISSION mission whose transcript receives decision requests
  ORB_ROADMAP_DRY_RUN=1    print the plan, change nothing
  ORB_ROADMAP_FILE         read the roadmap from this file instead of master
"""
import calendar, json, os, re, sqlite3, sys, time, urllib.request

ENV = os.environ.get
REPO = "Th0rgal/orb"
ROADMAP_PATH = "docs/plans/orb-roadmap.md"
CORE = ENV("ORB_ROADMAP_CORE", "http://127.0.0.1:3000")
STATE = ENV("ORB_ROADMAP_STATE", "/var/lib/orb-roadmap/state.json")
MISSIONS_DB = ENV("ORB_ROADMAP_MISSIONS_DB", "/root/.sandboxed-sh/missions/missions-prod.db")
MAX_WORKERS = int(ENV("ORB_ROADMAP_MAX_WORKERS", "3"))
MODELS = [m.strip() for m in ENV("ORB_ROADMAP_MODELS",
          "openai/gpt-6-astra,anthropic/claude-fable-5-2").split(",") if m.strip()]
IDLE_SECONDS = 15 * 60          # an idle worker is nudged after this long
FOREIGN_PR_SECONDS = 60 * 60    # an open PR touched this recently has an owner elsewhere
MAX_ATTEMPTS = 2                # missions per row before a human decides
QUICK_DEATH_SECONDS = 5 * 60    # a worker that ended this fast is replaced, not nudged
MASTER_WINDOW_SECONDS = 24 * 3600  # master-fix attempts older than this are forgotten
LIVE = {"pending", "active"}
ROW_ID = r"[A-Z]\d+[a-z]?"
MASTER_FIX = "MASTER"
EXCLUDE = ["exclude-node:nimrud", "exclude-node:agent-core", "exclude-node:lagash"]

# ---------------------------------------------------------------- pure logic


def parse_roadmap(text):
    """Rows of the DAG tables and the dispatch queue (section "Queue")."""
    rows, queue = {}, []
    in_queue = False
    for line in text.splitlines():
        if line.startswith("## "):
            in_queue = "queue" in line.lower()
            continue
        if in_queue:
            queue += [m for m in re.findall(r"`(" + ROW_ID + r")`", line) if m not in queue]
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) != 5 or not re.fullmatch(ROW_ID, cells[0]):
            continue
        rid, node, needs, state, done_when = cells
        rows[rid] = {"id": rid, "node": node, "needs": parse_needs(needs),
                     "state": state, "done_when": done_when}
    return rows, queue


def parse_needs(cell):
    """List of row ids, or None when a need is not a plain row id (a human,
    a date, an external PR): such a row is never dispatched automatically."""
    if cell in ("—", "-", ""):
        return []
    out = []
    for tok in cell.split(","):
        tok = tok.strip()
        if not re.fullmatch(ROW_ID, tok):
            return None
        out.append(tok)
    return out


def tagged_prs(prs):
    """{row id: {"open": [...], "merged": [...]}} from PR titles ending in (ID)."""
    out = {}
    for pr in prs:
        m = re.search(r"\((" + ROW_ID + r")\)\s*$", pr.get("title", ""))
        if not m:
            continue
        slot = out.setdefault(m.group(1), {"open": [], "merged": []})
        if pr.get("merged_at"):
            slot["merged"].append(pr)
        elif pr.get("state") == "open":
            slot["open"].append(pr)
    return out


def is_done(row, prs):
    return row["state"].startswith(("done", "dropped")) or bool(prs.get(row["id"], {}).get("merged"))


def plan(rows, queue, prs, missions, master_green, ledger, now):
    """Return the list of actions for this run. Pure: no I/O."""
    by_row = {}
    for m in missions:
        rid = m["track"][len("roadmap-"):]
        if rid == MASTER_FIX and now - m["created_ts"] > MASTER_WINDOW_SECONDS:
            continue
        if rid == MASTER_FIX or re.fullmatch(ROW_ID, rid):
            by_row.setdefault(rid, []).append(m)
    for ms in by_row.values():
        ms.sort(key=lambda m: m["created_at"])
    live = sum(1 for ms in by_row.values() for m in ms if m["status"] in LIVE)
    actions = []
    targets = queue if master_green else [MASTER_FIX]
    for rid in targets:
        row = rows.get(rid) or ({"id": rid, "node": "Master CI is red: make it green.",
                                 "needs": [], "state": "ready", "done_when": "The latest master CI run passes"}
                                if rid == MASTER_FIX else None)
        if row is None:
            actions.append(("report", rid, f"queue names {rid}, which is not a row of the DAG"))
            continue
        if rid != MASTER_FIX and is_done(row, prs):
            continue
        if row["needs"] is None or re.search(r"\((Thomas|operator)", row["state"]):
            continue  # waits on a human, a date or something outside the DAG
        if rid != MASTER_FIX and any(not is_done(rows[n], prs) for n in row["needs"] if n in rows):
            continue
        ms = by_row.get(rid, [])
        latest = ms[-1] if ms else None
        open_prs = prs.get(rid, {}).get("open", [])
        if latest and latest["status"] in LIVE:
            continue
        if latest is None:
            foreign = [p for p in open_prs if now - p["updated_ts"] < FOREIGN_PR_SECONDS]
            if foreign:
                continue  # someone else is driving that PR right now
            if live < MAX_WORKERS:
                actions.append(("start", rid, 1))
                live += 1
            continue
        if now - latest["updated_ts"] < IDLE_SECONDS:
            continue
        quick = latest["updated_ts"] - latest["created_ts"] < QUICK_DEATH_SECONDS
        if not quick and ledger.get("nudged", {}).get(latest["id"]) is None:
            actions.append(("nudge", rid, latest["id"]))
        elif len(ms) < MAX_ATTEMPTS:
            if live < MAX_WORKERS:
                actions.append(("start", rid, len(ms) + 1))
                live += 1
        elif ledger.get("reported", {}).get(rid) != latest["id"]:
            actions.append(("escalate", rid, latest["id"]))
    return actions


def brief(row, attempt, open_prs):
    rid = row["id"]
    prs = "".join(f"\n- open PR #{p['number']}: {p['title']} ({p['html_url']})" for p in open_prs)
    retry = ("" if attempt == 1 else
             f"\nThis is attempt {attempt}: an earlier worker on this row stopped without merging. "
             "Start from its branch or PR if one exists.")
    return f"""Roadmap row {rid} (docs/plans/orb-roadmap.md on master). You are its only worker.

Row: {row['node']}
Done when: {row['done_when']}{prs}{retry}

How to work:
- Read AGENTS.md and section 2 of the roadmap first.
- One branch, one PR. The PR title must end with "({rid})"; that is how the
  roadmap sees it. If an open PR above already does the job, adopt it instead.
- Push after every verified step. Run the tests for the area you touch.
- When every CI check on the exact head is green, squash-merge the PR
  yourself. A merged PR marks the row done; nobody else will merge it.
- Decide everything inside the row yourself: test fixtures, build bootstrap,
  rebases, re-running CI jobs that failed on runner infrastructure, splitting
  a C shim to stay under 220 lines. Only production authorization code,
  secrets, deploys and changes outside the row need a human: then end your turn
  with one line "BLOCKED: <question, options, your recommendation>".
- Never end a turn just to wait: if you wait on CI, arm a wakeup.
"""


def nudge_text(open_prs):
    pr = f" Your open PR: #{open_prs[0]['number']}." if open_prs else ""
    return ("You stopped without a merged PR." + pr + " Continue now: get the PR to green CI and "
            "squash-merge it, or end with one line \"BLOCKED: <question, options, recommendation>\" "
            "if a decision outside the row is needed.")

# ---------------------------------------------------------------- I/O


def http_json(url, data=None, headers=None, timeout=20):
    h = {"User-Agent": "orb-roadmap-reconcile", "Accept": "application/json"} | (headers or {})
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        h["Content-Type"] = "application/json"
    with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=h,
                                                       method="POST" if data is not None else "GET"),
                                timeout=timeout) as r:
        return json.load(r)


def iso_ts(s):
    return calendar.timegm(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")) if s else 0


def fetch_github():
    api = f"https://api.github.com/repos/{REPO}"
    if ENV("ORB_ROADMAP_FILE"):  # a local copy, for dry runs of a roadmap edit
        text = open(ENV("ORB_ROADMAP_FILE")).read()
    else:
        with urllib.request.urlopen(urllib.request.Request(
                f"https://raw.githubusercontent.com/{REPO}/master/{ROADMAP_PATH}",
                headers={"User-Agent": "orb-roadmap-reconcile"}), timeout=20) as r:
            text = r.read().decode()
    prs = http_json(f"{api}/pulls?state=all&sort=updated&direction=desc&per_page=100")
    for p in prs:
        p["updated_ts"] = iso_ts(p.get("updated_at"))
    runs = http_json(f"{api}/actions/runs?branch=master&event=push&per_page=10")["workflow_runs"]
    done = [r for r in runs if r["name"] == "CI" and r["status"] == "completed"]
    done = [r for r in done if r["conclusion"] in ("success", "failure")]  # cancelled runs say nothing
    master_green = not done or done[0]["conclusion"] == "success"
    return text, prs, master_green


def fetch_missions():
    con = sqlite3.connect(f"file:{MISSIONS_DB}?mode=ro", uri=True, timeout=10)
    rows = con.execute("SELECT id, status, track, created_at, updated_at FROM missions "
                       "WHERE track LIKE 'roadmap-%'").fetchall()
    return [{"id": r[0], "status": r[1], "track": r[2], "created_at": r[3] or "",
             "created_ts": iso_ts(r[3]), "updated_ts": iso_ts(r[4])} for r in rows]


def core_token():
    ns = {"__name__": "orb_monitor"}
    exec(compile(open("/usr/local/sbin/orb-monitor").read(), "orb-monitor", "exec"), ns)
    return ns["core_token"]()


def core_post(path, body):
    return http_json(CORE + path, body, {"Authorization": "Bearer " + core_token()})


def start_worker(row, attempt, open_prs):
    rid = row["id"]
    return core_post("/api/control/missions", {
        "title": f"Roadmap {rid}: {row['node'][:80]}", "prompt": brief(row, attempt, open_prs),
        "project": "now", "track": f"roadmap-{rid}", "backend": "opencode",
        "model_override": MODELS[(attempt - 1) % len(MODELS)], "remote_node_id": "auto", "tags": EXCLUDE,
        "idempotency_key": f"roadmap-{rid}-attempt-{attempt}"})


def main():
    dry = ENV("ORB_ROADMAP_DRY_RUN") == "1"
    now = time.time()
    text, prs_raw, master_green = fetch_github()
    rows, queue = parse_roadmap(text)
    prs = tagged_prs(prs_raw)
    missions = fetch_missions()
    try:
        ledger = json.load(open(STATE))
    except (OSError, ValueError):
        ledger = {}
    actions = plan(rows, queue, prs, missions, master_green, ledger, now)
    print(f"master {'green' if master_green else 'RED'}; queue {queue}; "
          f"live {[m['track'] for m in missions if m['status'] in LIVE]}; actions {actions}")
    if dry:
        return
    fix_row = {"id": MASTER_FIX, "node": "Master CI is red: find the failing check and fix it.",
               "done_when": "The latest master CI run passes"}
    for kind, rid, arg in actions:
        row = rows.get(rid, fix_row)
        open_prs = prs.get(rid, {}).get("open", [])
        try:
            if kind == "start":
                r = start_worker(row, arg, open_prs)
                print(f"started {rid} attempt {arg}: {r.get('id') or r.get('mission_id')}")
            elif kind == "nudge":
                core_post(f"/api/control/missions/{arg}/resume", {"content": nudge_text(open_prs)})
                ledger.setdefault("nudged", {})[arg] = int(now)
                print(f"nudged {rid} ({arg})")
            elif kind in ("escalate", "report"):
                inbox = ENV("ORB_ROADMAP_INBOX_MISSION", "").strip()
                msg = (f"Roadmap {rid} needs a decision: {MAX_ATTEMPTS} workers stopped without a "
                       f"merged PR; last mission {arg}." if kind == "escalate" else str(arg))
                if inbox:
                    core_post(f"/api/control/missions/{inbox}/client-transcript",
                              {"role": "assistant", "content": msg})
                    core_post(f"/api/control/missions/{inbox}/client-status", {"status": "awaiting_user"})
                ledger.setdefault("reported", {})[rid] = arg
                print(msg)
        except Exception as exc:  # one failed action never blocks the others
            print(f"{kind} {rid} failed: {type(exc).__name__}: {exc}", file=sys.stderr)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump(ledger, f)
    os.replace(STATE + ".tmp", STATE)


if __name__ == "__main__":
    main()
