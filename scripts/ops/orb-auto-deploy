#!/usr/bin/env bash
# orb-auto-deploy: hourly prod deploy of master when it is green and new.
# Approved by Thomas on 17 Nov for unattended operation. It only starts the
# governed `orb-deploy` (build, Core and Node self-tests, dev, health check,
# prod with backup and automatic rollback); it never deploys a red or pending
# commit and never runs while another deploy is active.
set -euo pipefail
REPO=Th0rgal/orb
api() { curl -fsS -m 20 -H "User-Agent: orb-auto-deploy" "https://api.github.com/repos/$REPO/$1"; }
if systemctl is-active --quiet orb-deploy; then echo "a deploy is running; skip"; exit 0; fi
# The newest master commit whose CI passed: merges often land faster than CI,
# so the head is usually still running and must not block every deploy.
sha=$(api "actions/runs?branch=master&event=push&per_page=30" | python3 -c '
import json,sys
runs=[r for r in json.load(sys.stdin)["workflow_runs"] if r["name"]=="CI"]
ok=[r for r in runs if r["status"]=="completed" and r["conclusion"]=="success"]
print(ok[0]["head_sha"] if ok else "")')
if [[ -z "$sha" ]]; then echo "no green master commit among recent runs; skip"; exit 0; fi
live=$(curl -fsS -m 10 http://127.0.0.1:3000/api/health | python3 -c 'import json,sys; print(json.load(sys.stdin).get("build",""))')
if [[ "$live" == "$sha" ]]; then echo "prod already on $sha"; exit 0; fi
# A commit whose deploy already failed is not retried: the master gets the log
# tail once and assigns a fix; the next green commit is deployed as usual.
LOG=/var/log/orb-deploy.log
if grep -q "deploy $sha " "$LOG" 2>/dev/null && ! grep -q "prod healthy on $sha" "$LOG"; then
  marker=/var/lib/orb-roadmap/deploy-failed-$sha
  if [[ ! -e $marker && -n "${ORB_ROADMAP_MASTER:-}" ]]; then
    tail=$(awk -v s="deploy $sha " 'index($0,s){f=1} f' "$LOG" | grep -vE "archived 0 legacy" | tail -25)
    python3 - "$ORB_ROADMAP_MASTER" "$sha" "$tail" <<'PY' && touch "$marker"
import sys
ns={"__name__":"x"}; exec(open("/usr/local/sbin/orb-roadmap-reconcile").read(), ns)
mid, sha, tail = sys.argv[1:4]
msg=(f"orb-auto-deploy: the prod deploy of master {sha} FAILED on agent-core and was not installed "
     f"(prod keeps the previous build). Start a child worker to find and fix the cause; the next green "
     f"commit deploys automatically. Last lines of /var/log/orb-deploy.log:\n{tail}")
ns["core_post"](f"/api/control/missions/{mid}/resume", {"content": msg})
PY
  fi
  echo "deploy of $sha already failed; not retrying"; exit 0
fi
echo "deploying $sha (prod on $live)"
exec /usr/local/sbin/orb-deploy --detach "$sha"
