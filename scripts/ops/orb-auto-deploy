#!/usr/bin/env bash
# orb-auto-deploy: hourly prod deploy of master when it is green and new.
# Approved by Thomas on 17 Nov for unattended operation. It only starts the
# governed `orb-deploy` (build, Core and Node self-tests, dev, health check,
# prod with backup and automatic rollback); it never deploys a red or pending
# commit and never runs while another deploy is active.
set -euo pipefail
REPO=Th0rgal/orb
api() { curl -fsS -m 20 -H "User-Agent: orb-auto-deploy" "https://api.github.com/repos/$REPO/$1"; }
if systemctl is-active --quiet orb-deploy; then echo "a deploy is running; skip"; exit 0; fi
sha=$(api "commits/master" | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])')
read -r status conclusion < <(api "actions/runs?branch=master&event=push&head_sha=$sha&per_page=10" | python3 -c '
import json,sys
runs=[r for r in json.load(sys.stdin)["workflow_runs"] if r["name"]=="CI"]
print(runs[0]["status"], runs[0]["conclusion"] or "-") if runs else print("missing -")')
if [[ "$status" != completed || "$conclusion" != success ]]; then echo "master $sha CI $status/$conclusion; skip"; exit 0; fi
live=$(curl -fsS -m 10 http://127.0.0.1:3000/api/health | python3 -c 'import json,sys; print(json.load(sys.stdin).get("build",""))')
if [[ "$live" == "$sha" ]]; then echo "prod already on $sha"; exit 0; fi
echo "deploying $sha (prod on $live)"
exec /usr/local/sbin/orb-deploy --detach "$sha"
