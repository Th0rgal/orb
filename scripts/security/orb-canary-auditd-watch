#!/usr/bin/env bash
# Paloma / Orb Canary Auditd Watcher (Wave 10)
# Enforces `Orb.Kernel.canaryTripwireStep` (`lean/Orb/Kernel.lean`):
# Every hit is forwarded to Core, which decides with `classify_actor_trust`
# (`crates/orb-spec`). The local classification only travels as metadata
# (`actor=` in the reason). Trust comes from kernel-attested facts alone: the
# audit record's numeric uid, an exact cgroup v2 path, and the audit `exe`,
# which replaces the attacker-controlled argv[0]. Argument text never grants
# trust, and an unknown uid is untrusted.
# 1. Ambient decoys (`env_honeytoken`, `vault_canary`, `mongo_27017`):
#    - Search / directory-walk tools (`rg`, `grep`, `find`, `fd`, `ls`, `git`, ...) run by
#      the agent uid in `orb-node.service` or a `missions.slice` scope are classified
#      `whitelisted_agent_walk` (Core: no node quarantine, no fleet bunker).
#    - Other mission processes (`actor_trust = MissionProcess`) trigger node-local quarantine
#      and report to Core (`QuarantineNodeOnly` — quarantines ONLY this node, not the whole fleet).
# 2. High-signal attacker bait (`btc_wallet_canary` / `btc-treasury-wallet.dat`, `ssh_exfil_canary`):
#    - Bypasses the process whitelist (`canary_high_signal_bait_always_locks_down`): even if
#      accessed by our own agent process (indicating stolen device or MITM'd inference), immediately
#      quarantines the node and escalates the fleet to `HardLockdown (2)`.
set -euo pipefail

STATE_FILE="/var/lib/lean-mesh/canary-audit-cursor"
TRIPWIRE="/usr/local/sbin/orb-canary-tripwire"
mkdir -p /var/lib/lean-mesh
chmod 700 /var/lib/lean-mesh

LAST_TS="$(cat "$STATE_FILE" 2>/dev/null || echo 0)"

AGENT_UID=999
UNKNOWN_UID=4294967295

# Mirrors `is_agent_cgroup` in crates/orb-spec: exact paths only.
is_agent_cgroup() {
  case "$1" in
    /system.slice/orb-node.service|/system.slice/sandboxed-node.service) return 0 ;;
    /missions.slice/?*.scope)
      [[ "${1#/missions.slice/}" != */* ]]
      return
      ;;
    *) return 1 ;;
  esac
}

# Mirrors `classify_actor_trust` in crates/orb-spec (metadata only; Core decides).
classify_actor() {
  local uid="$1" cgroup="$2" exe="$3"
  if [[ "$uid" != "$AGENT_UID" ]] || { [[ -n "$cgroup" ]] && ! is_agent_cgroup "$cgroup"; }; then
    echo untrusted_or_system
    return
  fi
  local exe_name="${exe##*/}"
  case "${exe_name,,}" in
    rg|ripgrep|grep|egrep|fgrep|find|fd|fdfind|ls|stat|file|du|tree|git) echo whitelisted_agent_walk ;;
    *) echo mission_process ;;
  esac
}

is_high_signal_bait() {
  local kind="$1"
  case "$kind" in
    btc_wallet_canary|ssh_exfil_canary|*btc*|*bitcoin*|*wallet*|*high_signal*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

while true; do
  for KEY_PAIR in \
    "paloma_canary_env:env_honeytoken" \
    "paloma_canary_vault:vault_canary" \
    "paloma_canary_btc:btc_wallet_canary" \
    "paloma_canary_ssh:ssh_exfil_canary"; do
    KEY="${KEY_PAIR%%:*}"
    KIND="${KEY_PAIR##*:}"
    # Raw (not `-i`) records keep the numeric uid the kernel attested.
    LINE="$(ausearch -k "$KEY" 2>/dev/null | grep -E 'type=SYSCALL' | tail -n 1 || true)"
    if [[ -n "$LINE" ]]; then
      EVENT_ID="$(echo "$LINE" | grep -oE 'audit\([^)]+\)' | head -n 1 || true)"
      if [[ -n "$EVENT_ID" && "$EVENT_ID" != "$LAST_TS" ]]; then
        PID="$(echo "$LINE" | grep -oE ' pid=[0-9]+' | head -n 1 | cut -d= -f2 || true)"
        PID="${PID:-0}"
        UID_NUM="$(echo "$LINE" | grep -oE ' uid=[0-9]+( |$)' | head -n 1 | cut -d= -f2 | tr -d ' ' || true)"
        # An unknown uid is never the agent uid.
        UID_NUM="${UID_NUM:-$UNKNOWN_UID}"
        COMM="$(echo "$LINE" | grep -oE ' comm="[^"]*"' | head -n 1 | cut -d'"' -f2 || true)"
        COMM="${COMM:-unknown}"
        EXE="$(echo "$LINE" | grep -oE ' exe="[^"]*"' | head -n 1 | cut -d'"' -f2 || true)"
        EXE="${EXE:-unknown}"

        # Exact cgroup v2 path; empty when the process already exited.
        CGROUP="$(sed -n 's/^0:://p' "/proc/$PID/cgroup" 2>/dev/null | head -n 1 || true)"
        # argv[0] is attacker-controlled: replace it with the audit `exe`.
        ARGS=()
        if [[ -r "/proc/$PID/cmdline" ]]; then
          mapfile -d '' -t ARGS < "/proc/$PID/cmdline" 2>/dev/null || ARGS=()
        fi
        CMDLINE="$EXE"
        if [[ ${#ARGS[@]} -gt 1 ]]; then
          CMDLINE+="$(printf ' %s' "${ARGS[@]:1}")"
        fi
        CMDLINE="${CMDLINE:0:240}"

        echo "$EVENT_ID" > "$STATE_FILE"
        LAST_TS="$EVENT_ID"

        if is_high_signal_bait "$KIND"; then
          ACTOR=high_signal_bait
        else
          ACTOR="$(classify_actor "$UID_NUM" "$CGROUP" "$EXE")"
        fi
        logger -t orb-canary-auditd-watch "canary hit forwarded to Core: kind=$KIND actor=$ACTOR event=$EVENT_ID pid=$PID uid=$UID_NUM comm=$COMM"

        "$TRIPWIRE" "$KIND" "auditd key=$KEY event=$EVENT_ID actor=$ACTOR comm=$COMM exe=$EXE" "$PID" "$UID_NUM" "$CGROUP" "$CMDLINE" || true
      fi
    fi
  done
  sleep 2
done
