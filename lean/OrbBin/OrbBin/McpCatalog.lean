e_authority\": {\n          \"description\": \"Request final guarded merge capability for a dedicated integrator. This is not self-authorization: the trusted Hermes client grants it only when github_pr matches the operator-configured repository allowlist.\",\n          \"type\": \"boolean\"\n        },\n        \"supersedes_mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tags\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Track/workstream (e.g. \\\"core-c3\\\").\",\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        },\n        \"writer\": {\n          \"description\": \"Capability boundary for the associated PR. Use false for every reviewer/certifier (server-enforced read-only git/gh); use true for any branch, comment, thread, approval, or merge mutation. Concurrent writers for one PR are rejected.\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"prompt\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"consult_model\",\n    \"description\": \"Ask another model a question (review, second opinion, very hard read-only question) without hand-building a mission. Creates a child mission in the caller's project, on the caller's machine and workspace, with backend=opencode, model_override=<provider>/<model> and writer=false (pr-readonly) unless read_only=false. `model` is a full <provider>/<model> id or a short alias (gpt-6-astra, fable-5.2, opus-5.5); unknown or ambiguous names are rejected with the valid ids. It returns {mission_id} at once and never waits: poll get_consult_result(mission_id) until it returns the answer. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"files\": {\n          \"description\": \"Paths (in the shared workspace) the consultant must read.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"github_pr\": {\n          \"description\": \"PR under review (owner/repo#123), if any.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"model\": {\n          \"description\": \"<provider>/<model> (e.g. openai/gpt-6-astra) or a short alias (gpt-6-astra, fable-5.2, opus-5.5).\",\n          \"type\": \"string\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Injected by the Hermes plugin when present; never invent one.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Defaults to the calling mission's project.\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"description\": \"The question, with all context the consultant needs.\",\n          \"type\": \"string\"\n        },\n        \"read_only\": {\n          \"description\": \"Default true (writer=false, pr-readonly). false lets the consultant write.\",\n          \"type\": \"boolean\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"model\",\n        \"question\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_consult_result\",\n    \"description\": \"Read the outcome of a consult_model mission without waiting: {status, done} while it runs, plus the consultant's final answer once it is no longer pending/active. Poll it (e.g. every minute) instead of blocking.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"send_message_to_mission\",\n    \"description\": \"Send a follow-up to an existing native or cloud mission. Core derives a stable message identity from the action key. Use answer_mission_question for a pending agent question; ordinary follow-ups may queue behind it. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"cloud_model\": {\n          \"description\": \"Model for this cloud turn only. Discover supported models before selecting.\",\n          \"type\": \"string\"\n        },\n        \"cloud_model_params\": {\n          \"items\": {\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"value\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"value\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"content\": {\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"ask_mission\",\n    \"description\": \"Ask a read-only question to a mission's Ask copilot (a sidecar with bash + workspace access) WITHOUT disturbing the mission or waking its main agent. Use this to inspect a mission's workspace/state or get analysis. Returns the copilot's answer and a thread_id; pass thread_id back to continue the same conversation. This does NOT send a message to the mission agent — use send_message_to_mission for that. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"content\": {\n          \"description\": \"The question for the copilot.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"sandbox\": {\n          \"description\": \"Optional: isolate bash writes in a throwaway copy of the workspace (default false).\",\n          \"type\": \"boolean\"\n        },\n        \"thread_id\": {\n          \"description\": \"Optional: continue an existing Ask thread.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"answer_mission_question\",\n    \"description\": \"Answer a mission's pending AskUserQuestion so its blocked turn resumes immediately. A mission parked on a question cannot be unblocked with send_message_to_mission — plain messages QUEUE BEHIND the blocked turn — so this is the way a controller answers instead of leaving the mission in awaiting_user. `answers` is an array of arrays: one inner array per question, each entry an option label (preferred) or free text. Omit tool_call_id to auto-target the mission's single unanswered question; if several are pending you get an error listing them. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"answers\": {\n          \"description\": \"One inner array per question, e.g. [[\\\"Option A\\\"]].\",\n          \"items\": {\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tool_call_id\": {\n          \"description\": \"Optional: the AskUserQuestion tool_call id to answer. Omit to use the newest unanswered one.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"answers\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_mission\",\n    \"description\": \"Request cancellation of a running or pending mission. Acceptance is not proof of termination. Follow the receipt's next_tool: get_cloud_execution for provider confirmation, or get_mission_health for native runner termination. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"start_workspace_job\",\n    \"description\": \"Start a restart-safe long-running command in a workspace and return immediately with a durable job id. Supply exactly one of command or argv. Retries must reuse the same idempotency_key; a reused key cannot submit duplicate work. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"argv\": {\n          \"description\": \"Argument vector, safely shell-quoted. Mutually exclusive with command.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"command\": {\n          \"description\": \"Shell command. Mutually exclusive with argv.\",\n          \"type\": \"string\"\n        },\n        \"cwd\": {\n          \"description\": \"Working directory relative to the workspace root.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"resource_class\": {\n          \"description\": \"Scheduling hint such as lean_heavy, cpu, or io.\",\n          \"type\": \"string\"\n        },\n        \"timeout_secs\": {\n          \"description\": \"Absolute runtime limit. Default 7200 seconds, maximum 86400.\",\n          \"type\": \"integer\"\n        },\n        \"workspace_id\": {\n          \"description\": \"Workspace UUID. Defaults to the assistant default workspace.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace_job\",\n    \"description\": \"Inspect a durable workspace job by id, including heartbeat, deadline, scope, exit status, and bounded stdout/stderr tails.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"job_id\": {\n          \"type\": \"string\"\n        },\n        \"tail_bytes\": {\n          \"description\": \"Maximum bytes from each log, default 16384, maximum 65536.\",\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"job_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_workspace_job\",\n    \"description\": \"Idempotently request cancellation of a durable workspace job. Returns after cancellation is recorded; process teardown continues asynchronously. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_health\",\n    \"description\": \"Diagnose where a mission stands: live run state, stall severity, detected error signals (rate limit / auth / capacity / context-limit / network), suspected tool loops, the last assistant message, and a one-line recommendation. Use this first when babysitting a long-running mission — it summarizes 'where it is struggling' instead of making you read raw events. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_diagnostics\",\n    \"description\": \"Deep-dive a mission: recent tool calls, deduplicated result snippets, per-tool counts, repeated calls, and bounded error summaries. Use get_mission_events for raw receipts. Use when get_mission_health flags a problem and you need to see exactly what the model is doing.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Trace events to scan from the tail, default 80, max 300.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"resume_mission\",\n    \"description\": \"Resume an interrupted, blocked or failed mission. Bound Codex missions reattach to the same native thread, cwd, HOME and account; existing native goals preserve their objective, token budget and accumulated usage. Grok resumes its recorded native session; a first handoff creates a Grok session while preserving other harness identities. For a mission parked in awaiting_user or acknowledged, send_message_to_mission wakes it on the same id and is the normal choice. Pass `content` as the exact current steering input; on a bound native goal it steers that goal's turn. A new Codex /goal objective must be at most 4000 Unicode characters; oversized objectives are rejected without truncation. Without `content`, persisted Codex goal missions resume the full stored /goal objective; other missions receive the default continue-where-you-left-off prompt. Native blocked/paused/usageLimited/budgetLimited stops park as blocked with terminal_reason=native_goal_stopped after the final response drains; they never mean goal completion. Resolve the reported stop before resuming. codex_continuity_required or native_continuity_required means native identity/history or a tool outcome requires reconciliation: do not repeat identical resumes, change accounts, or assume a fresh thread or reset budget. Queued steering retains its durable order; unconfirmed native delivery is reported explicitly. For existing work with excluded/collaborating PR references, read get_mission and pass continue_identity with the exact stored project, track and github_pr (null if unset). For different work use explicit github_pr/track identity updates instead; ownership checks still apply. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"clean_workspace\": {\n          \"description\": \"Wipe the work directory before resuming. Rarely needed; default false.\",\n          \"type\": \"boolean\"\n        },\n        \"content\": {\n          \"description\": \"Optional steering message used as the resume turn's prompt.\",\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"delay_seconds\": {\n          \"maximum\": 3600,\n          \"minimum\": 60,\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"delay_seconds\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_job_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_search_knowledge\",\n    \"description\": \"Search curated Hindsight knowledge pages (`thomas` or `ppl` bank) via Core's governed memory broker. Returns matching page titles, paths, and excerpts in one round-trip without exposing raw API keys to the worker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` for general personal/project context, `ppl` for people/relationships; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"limit\": {\n          \"description\": \"Maximum results to return (1..=25, default 10).\",\n          \"maximum\": 25,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Search query keywords or phrase.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_page\",\n    \"description\": \"Read a full curated Hindsight knowledge page by `path` (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Knowledge page path returned by `memory_search_knowledge` or `memory_get_knowledge_tree`.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_tree\",\n    \"description\": \"List the curated Hindsight knowledge directory tree (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Optional subtree prefix to inspect.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_recall\",\n    \"description\": \"Recall raw episodic memories from Hindsight (`thomas` or `ppl` bank) when curated knowledge pages (`memory_search_knowledge`) do not yet cover a topic.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Memory bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"max_tokens\": {\n          \"description\": \"Token budget for recalled memories (1..=8192, default 4096).\",\n          \"maximum\": 8192,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Natural-language recall query.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  }\n]"

def coordinatorCatalogPrettyJson : String :=
  "[\n  {\n    \"name\": \"get_capabilities\",\n    \"description\": \"Read the authenticated identity, effective role, contract version, tools and limits. No work is started.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_action\",\n    \"description\": \"Read an accepted action receipt and its result. A pending or uncertain action must never be submitted with a new key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"action_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"action_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_action\",\n    \"description\": \"Cancel an action that is still queued. Returns a durable cancellation receipt. Once dispatch started, cancellation is not claimed: inspect the target and use cancel_mission or cancel_workspace_job.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"action_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"action_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"create_worktree\",\n    \"description\": \"Create a Git worktree inside the mission workspace on its current machine. Paths are relative to the mission root. Specify repo_path when the checkout is in a subdirectory.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"base\": {\n          \"type\": \"string\"\n        },\n        \"branch\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"type\": \"string\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"branch\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"remove_worktree\",\n    \"description\": \"Remove a clean worktree inside the mission workspace on its current machine. Dirty worktrees are preserved; forced removal is not supported.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"type\": \"string\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"merge_branch\",\n    \"description\": \"Merge in the mission workspace on its current machine. The checkout must be clean and already on target_branch. Conflicts are reported and the merge is aborted; assign a resolver after inspecting the receipt. Optional source deletion only removes fully merged branches.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"delete_source\": {\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"push\": {\n          \"type\": \"boolean\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        },\n        \"source_branch\": {\n          \"type\": \"string\"\n        },\n        \"target_branch\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"source_branch\",\n        \"target_branch\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_list\",\n    \"description\": \"List the names (never values) of Thomas's secrets: which ones this mission can read now, and which need his approval, grouped by Bitwarden project.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_get\",\n    \"description\": \"Get one secret by name. Secrets in this project's default Bitwarden projects come back at once; others ask Thomas (Touch ID / Face ID) and wait up to 20 s, then return `pending` — call again later. The value is written to a private file; the result gives its path and an `export` line. Never print the value or paste it into chat, commits or logs.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Why the mission needs it; shown to Thomas.\",\n          \"maxLength\": 500,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_request\",\n    \"description\": \"Ask Thomas for read access to a whole Bitwarden project (by name), or `all`, for this mission. Waits up to 20 s for approval, then returns `pending`.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_put\",\n    \"description\": \"Store a secret (create, or update the value) in a Bitwarden project. Always needs Thomas's approval; waits up to 20 s, then returns `pending`. Use UPPER_SNAKE_CASE names and the project that fits (see secret_list for project names).\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"note\": {\n          \"maxLength\": 2000,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"maxLength\": 65536,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"value\",\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_delete\",\n    \"description\": \"Permanently delete a secret from Bitwarden. Always needs Thomas's approval; waits up to 20 s, then returns `pending` — call again later. If the same name exists in several projects, pass `bitwarden_project` to pick which copy to delete. To rename a secret: secret_get the old name, secret_put the new one, then secret_delete the old one.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"description\": \"Project holding the copy to delete; only needed when the name is duplicated.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_move\",\n    \"description\": \"Move a secret (value and note unchanged) to another Bitwarden project. Always needs Thomas's approval; waits up to 20 s, then returns `pending` — call again later.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"description\": \"Destination project.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"request_mission_access\",\n    \"description\": \"Ask Thomas for read-only access to another mission that you did not start and that is not in your tree (when get_mission / get_mission_events answer \\\"outside this session's scope\\\"). He approves on his device with Touch ID / Face ID. Waits up to 20 s, then returns `pending`; you get a message when he decides, or call list_mission_access. Once approved (default 24 h), get_mission, get_mission_events, get_mission_health and list_mission_shared_files work on that mission. Never grants control: sending messages, cancel, resume and placement stay denied.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"reason\": {\n          \"description\": \"Why you need it; shown to Thomas.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"scope\": {\n          \"default\": \"read\",\n          \"enum\": [\n            \"read\"\n          ],\n          \"type\": \"string\"\n        },\n        \"target_mission_id\": {\n          \"description\": \"Full UUID of the mission to read.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"ttl_hours\": {\n          \"description\": \"How long you need it (default 24).\",\n          \"maximum\": 168,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"target_mission_id\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_mission_access\",\n    \"description\": \"List this mission's access requests to other missions and their status (pending, approved with expiry, denied, expired, revoked).\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"spawn_managed_machine\",\n    \"description\": \"Rent a fresh, disposable cloud VM (boat.dev, EU) and enroll it as a compute node, so you can run a subagent or heavy job on dedicated CPU/RAM instead of sharing the fleet. Use this whenever a task needs more compute than you have (parallel builds, big test suites, memory-hungry Lean/Rust/ML work, isolation from the shared nodes) or get_compute_fleet shows no free capacity. You choose the size: small = 2 vCPU / 4 GB RAM / 12 GB disk ($0.018/h, default), default = 4 vCPU / 8 GB / 50 GB ($0.036/h), large = 8 vCPU / 16 GB / 125 GB ($0.072/h), xlarge = 16 vCPU / 32 GB / 251 GB ($0.20/h); or pass cpu and/or ram_gb and the smallest fitting size is picked. The VM comes with claude, codex, opencode, gemini, agy, elan/Lean v4.35.0, turbo-lean, lean-native and certified-search, but NO credentials and no private checkouts (it is an untrusted, managed trust class: never send secrets, tokens or credentials there; private repository source may be built there only when the operator has explicitly authorized it for this mission, delivered as a git bundle or attachment from a trusted node and never by placing a token on the VM). Result (via get_action) has its short `name` (e.g. small-a, large-b): start a subagent there with start_mission(remote_node_id=name, backend=..., prompt=...). Shortcut: start_mission(remote_node_id=\\\"auto-managed:<size>\\\") spawns and places in one call. All sizes run the same CPU (AMD Ryzen 9 9950X, Zen 5, AVX-512, VPCLMULQDQ): size buys cores and RAM, not CPU features, so use small or default for probes and audits. Every machine has a TTL (default 60 min, auto-extended in 30 min chunks while busy, max 720) and is destroyed a few minutes after your mission ends, 15 idle minutes after it is interrupted or waiting, or at its TTL. It is charged to your mission's budget pool if one is set (see get_budget). Call destroy_managed_machine as soon as you are done. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"cpu\": {\n          \"description\": \"Minimum vCPUs needed (alternative to size).\",\n          \"maximum\": 16,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"from_snapshot\": {\n          \"description\": \"Start from one of your project's snapshots (list_managed_snapshots) with repos, toolchains and caches ready.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"image\": {\n          \"description\": \"Image (named snapshot). Default orb-node-base.\",\n          \"type\": \"string\"\n        },\n        \"ram_gb\": {\n          \"description\": \"Minimum RAM in GB needed (alternative to size).\",\n          \"maximum\": 32,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"reason\": {\n          \"description\": \"Why you need it (shown to the operator and in the cost ledger).\",\n          \"type\": \"string\"\n        },\n        \"size\": {\n          \"description\": \"small=2 vCPU/4 GB, default=4 vCPU/8 GB, large=8 vCPU/16 GB, xlarge=16 vCPU/32 GB. Omit to use cpu/ram_gb or the default (small).\",\n          \"enum\": [\n            \"small\",\n            \"default\",\n            \"large\",\n            \"xlarge\"\n          ],\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"description\": \"Initial lifetime; auto-extended while busy (within budget). Default 60.\",\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_managed_machines\",\n    \"description\": \"List live managed VMs (boat.dev) compactly: name, size, state, owner, expires_at, reap_at, cost so far, plus today's spend, running count and caps (null = unlimited). Pass verbose=true for full rows and the last 24 h of destroyed machines. Check this before spawning to reuse a machine you already own.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"verbose\": {\n          \"description\": \"Full rows and history (large).\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"snapshot_managed_machine\",\n    \"description\": \"Save a named snapshot of a managed VM for your project (warm image: repos cloned, toolchains installed, build caches built). Put state outside /tmp and ~/.cache (snapshots do not keep them). Takes seconds to minutes (status saving -> ready); delivered secrets are removed first. Start children from it with spawn_managed_machine(from_snapshot=name) or start_mission(remote_node_id=\\\"auto-managed:<size>\\\", managed_from_snapshot=name). 10 snapshots are free, then $1.70/month each; Core keeps the newest 2 per project and deletes ones unused for 14 days. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"description\": \"Short label, e.g. lean-native-warm\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_managed_snapshots\",\n    \"description\": \"List your project's managed-VM snapshots: name, label, status, source machine, size, created/last used, monthly storage cost.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"delete_managed_snapshot\",\n    \"description\": \"Delete one of your project's snapshots (refused while a machine is being created from it). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"fork_managed_machine\",\n    \"description\": \"Create a new managed VM from another VM's current state (a subagent starting from your built tree). Boat forks from the latest background snapshot, which can be about a minute stale: write and `sync` what the child needs and wait ~60 s first, or take a named snapshot for an exact copy. Same size unless size is given; budget and caps apply like a new VM. Then start_mission(remote_node_id=<returned name>). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"size\": {\n          \"enum\": [\n            \"small\",\n            \"default\",\n            \"large\",\n            \"xlarge\"\n          ],\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"stop_managed_machine\",\n    \"description\": \"Stop a managed VM you will need again later: billing stops, the disk is kept (resume within 24 h). Prefer this to leaving a VM idle. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"resume_managed_machine\",\n    \"description\": \"Resume a stopped managed VM (same name and node id; files kept, processes restart). Budget and caps apply. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_budget\",\n    \"description\": \"Your mission's managed-VM spending budget: mode (own, pooled from an ancestor, or none = only the daily cap), the pool's budget, spent, reserved (min(TTL, 60 min) of each live VM), held by children's sub-budgets, remaining, the most you may grant a child (start_mission budget_usd), and each child's usage. Spawns, extensions and sub-budgets beyond the remaining amount are refused with budget_exceeded / sub_budget_exceeds_pool.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"destroy_managed_machine\",\n    \"description\": \"Destroy a managed VM you no longer need (stops billing immediately and closes its cost ledger). Idempotent. Pass the machine name (e.g. small-a), id (mm…) or node id (managed-mm…). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"extend_managed_machine\",\n    \"description\": \"Extend a managed VM's TTL by ttl_minutes beyond its current expiry (total lifetime capped at 720 minutes after creation). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"ttl_minutes\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_active_missions\",\n    \"description\": \"List active, pending, blocked, or awaiting-user missions in sandboxed.sh. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis. Results are bounded pages. Follow next_offset while non-null, including after an empty filtered page. Concurrent inserts may shift offsets; deduplicate by mission ID.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum missions to return, default 50.\",\n          \"type\": \"integer\"\n        },\n        \"offset\": {\n          \"description\": \"Use the preceding page's next_offset; omit for the first page.\",\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Optional filter: only missions launched from this Hermes conversation.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Optional filter: exact project id.\",\n          \"type\": \"string\"\n        },\n        \"project_prefix\": {\n          \"description\": \"Optional filter: project FAMILY — matches the id and its `-` suffixed variants (e.g. verity covers verity-core, verity-phase1d). Use this when a project's work is still split across per-phase ids.\",\n          \"type\": \"string\"\n        },\n        \"tag\": {\n          \"description\": \"Optional filter: only missions carrying this tag.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Optional filter: exact track within a project.\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_missions\",\n    \"description\": \"List missions on the attention horizon: live, waiting, blocked, and unabsorbed failed/interrupted attempts. Acknowledged, completed, and replaced attempts are omitted unless you pass an explicit status. Filter by project or track to see attempts on one item. Prefer get_project for the item-first inventory. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis. Results are bounded pages. Follow next_offset while non-null, including after an empty filtered page. Concurrent inserts may shift offsets; deduplicate by mission ID.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum missions to return, default 50.\",\n          \"type\": \"integer\"\n        },\n        \"offset\": {\n          \"description\": \"Use the preceding page's next_offset; omit for the first page.\",\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Optional filter: only missions launched from this Hermes conversation.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Optional filter: exact project id.\",\n          \"type\": \"string\"\n        },\n        \"project_prefix\": {\n          \"description\": \"Optional filter: project FAMILY — matches the id and its `-` suffixed variants (e.g. verity covers verity-core, verity-phase1d). Use this when a project's work is still split across per-phase ids.\",\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"description\": \"Optional mission status filter.\",\n          \"type\": \"string\"\n        },\n        \"tag\": {\n          \"description\": \"Optional filter: only missions carrying this tag.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Optional filter: exact track within a project.\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission\",\n    \"description\": \"Compatibility alias for the compact ~2KB mission digest. It never returns the full history; use get_mission_events with a bounded limit for transcript or trace details. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_events\",\n    \"description\": \"Fetch persisted mission events. Without a cursor, returns the newest bounded page in ascending order; use before_seq to page backwards or since_seq for deltas.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"before_seq\": {\n          \"description\": \"Page backwards: return the newest events with sequence below this value (takes precedence over since_seq).\",\n          \"type\": \"integer\"\n        },\n        \"limit\": {\n          \"description\": \"Maximum events to return, default 40 newest events.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"since_seq\": {\n          \"description\": \"Return events with sequence greater than this value.\",\n          \"type\": \"integer\"\n        },\n        \"view\": {\n          \"enum\": [\n            \"transcript\",\n            \"trace\",\n            \"history\",\n            \"all\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_mission_shared_files\",\n    \"description\": \"List files and screenshots shared by assistant messages in a sandboxed.sh mission.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum mission events to scan, default 40.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_cloud_models\",\n    \"description\": \"Discover actual hosted model IDs, labels and supported parameter combinations before creating or following up a cloud mission. Grok Bot has no model selector.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"provider\": {\n          \"enum\": [\n            \"chatgpt\",\n            \"cursor_cloud\",\n            \"hermes\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"provider\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_cloud_accounts\",\n    \"description\": \"Discover hosted agent accounts and effective capabilities. Unavailable connectors cannot launch; connecting never starts work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_cloud_execution\",\n    \"description\": \"Read a bounded page of durable hosted turns, external identities and results. Defaults to the latest turn and 4096 characters per result/detail; prompts are omitted. Pass offset=0 to read from the beginning. Follow page.next_offset for subsequent turns. To continue text, select that turn with offset and limit=1, then pass its text_slices field's next_offset as text_offset. Character offsets are Unicode scalar values. Poll the last unfinished turn again until terminal; revision changes as execution advances. Artifact/branch payloads are omitted; counts are included. Transport loss is not completion.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"include_prompt\": {\n          \"type\": \"boolean\"\n        },\n        \"limit\": {\n          \"maximum\": 5,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"offset\": {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"text_limit\": {\n          \"maximum\": 8192,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"text_offset\": {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"start_mission\",\n    \"description\": \"Launch one native or cloud mission. Native launches select a backend/workspace/model; cloud launches select cloud.provider/account and optional repository/model. Discover cloud availability with list_cloud_accounts and list_cloud_models. Every role can use owner cloud accounts within quotas. Core supplies the parent identity for executors. Pass project/track and acceptance criteria for governed work; reviewers use writer=false. For a review or second opinion from another model, call consult_model instead. Mission completion and accepted project evidence remain separate. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"acceptance_criteria\": {\n          \"description\": \"Outcome contract used when this dispatch declares the track. Existing satisfied tracks are never reopened implicitly.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"agent\": {\n          \"type\": \"string\"\n        },\n        \"attachments\": {\n          \"description\": \"Ordinary files to materialize under .paloma/ before the harness starts. Not vendor-CLI @ syntax.\",\n          \"items\": {\n            \"properties\": {\n              \"kind\": {\n                \"enum\": [\n                  \"file\",\n                  \"folder\",\n                  \"controller\"\n                ],\n                \"type\": \"string\"\n              },\n              \"path\": {\n                \"description\": \"Project-relative path for file/folder chips.\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"kind\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"backend\": {\n          \"enum\": [\n            \"opencode\",\n            \"claudecode\",\n            \"codex\",\n            \"grok\",\n            \"antigravity\",\n            \"vibe\"\n          ],\n          \"type\": \"string\"\n        },\n        \"budget_usd\": {\n          \"description\": \"Optional managed-VM budget (USD) for the child and its descendants. Under your own budget pool it is a sub-budget carved from it and must not exceed its remaining amount (see get_budget). Omit to let the child share your pool.\",\n          \"minimum\": 0,\n          \"type\": \"number\"\n        },\n        \"cloud\": {\n          \"additionalProperties\": false,\n          \"description\": \"Hosted execution. Discover availability with list_cloud_accounts. Requires idempotency_key; never pass credentials, machine paths or attachments.\",\n          \"properties\": {\n            \"account\": {\n              \"type\": \"string\"\n            },\n            \"git_ref\": {\n              \"type\": \"string\"\n            },\n            \"model\": {\n              \"type\": \"string\"\n            },\n            \"model_params\": {\n              \"items\": {\n                \"properties\": {\n                  \"id\": {\n                    \"type\": \"string\"\n                  },\n                  \"value\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"id\",\n                  \"value\"\n                ],\n                \"type\": \"object\"\n              },\n              \"type\": \"array\"\n            },\n            \"provider\": {\n              \"enum\": [\n                \"chatgpt\",\n                \"grok_bot\",\n                \"cursor_cloud\",\n                \"hermes\"\n              ],\n              \"type\": \"string\"\n            },\n            \"repository\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"provider\",\n            \"account\"\n          ],\n          \"type\": \"object\"\n        },\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"desired_state\": {\n          \"description\": \"Track state, e.g. waiting_ci / waiting_review / blocked_external.\",\n          \"type\": \"string\"\n        },\n        \"estimated_disk_gib\": {\n          \"description\": \"Expected peak local scratch use. Set this for Lean/build-heavy missions; omit for small/no-build work.\",\n          \"maximum\": 512,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"fast_mode\": {\n          \"description\": \"Enable Codex fast mode (service tier fast). Requires backend=codex and an explicit GPT-5.6, GPT-5.5, or GPT-5.4 model_override. Uses ChatGPT credits faster.\",\n          \"type\": \"boolean\"\n        },\n        \"github_pr\": {\n          \"description\": \"Associated PR ref (e.g. \\\"owner/repo#123\\\").\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"intent\": {\n          \"description\": \"Intent (e.g. \\\"review_merge_pr\\\").\",\n          \"type\": \"string\"\n        },\n        \"managed_from_snapshot\": {\n          \"description\": \"Only with remote_node_id auto-managed: start the child's VM from this project snapshot (list_managed_snapshots) instead of the base image, so repos, toolchains and build caches are already there.\",\n          \"type\": \"string\"\n        },\n        \"managed_ttl_minutes\": {\n          \"description\": \"Only with remote_node_id auto-managed: initial machine TTL in minutes (default 60, auto-extended while busy).\",\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        },\n        \"model_effort\": {\n          \"enum\": [\n            \"low\",\n            \"medium\",\n            \"high\",\n            \"xhigh\",\n            \"max\"\n          ],\n          \"type\": \"string\"\n        },\n        \"model_override\": {\n          \"description\": \"Exact account-supported model ID. For opencode use <provider>/<model> (e.g. openai/gpt-6-astra). For Codex Terra use gpt-5.6-terra with medium effort. Never invent variants such as gpt-5.5-sol. Codex on a remote node (remote_node_id, e.g. auto-managed:default / auto-managed:large) runs through the core proxy: pass model_override explicitly (e.g. gpt-6.1-sol); if omitted, the configured Codex default is used and recorded on the mission.\",\n          \"type\": \"string\"\n        },\n        \"next_check_at\": {\n          \"description\": \"When the track should next be checked (RFC3339).\",\n          \"type\": \"string\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Implementation routing hint (Hermes session id). Injected by the Hermes plugin when present. Controllers should pass project/track instead; completion is a mission row, not a chat callback. Never invent another session's id.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Stable project id (e.g. \\\"verity\\\").\",\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Codex native /goal objective: maximum 4000 Unicode characters, including automatic writer promotion. Put supporting detail in referenced artifacts; never rely on truncation.\",\n          \"type\": \"string\"\n        },\n        \"remote_node_id\": {\n          \"description\": \"Native node placement: a registered node id, \\\"auto\\\" for the fleet scheduler (least-loaded eligible static node), a managed machine's name (\\\"small-a\\\", from spawn_managed_machine) or its node id, or \\\"auto-managed\\\" / \\\"auto-managed:<small|default|large|xlarge>\\\" to rent a boat.dev VM of that size for this child (validated before renting; an idle VM of the same size left by an ended sibling is reused; default small; the child owns it and it is destroyed shortly after the child ends, or at its TTL; call destroy_managed_machine to release it earlier). Omit to inherit the parent's node and workspace. A child placed elsewhere starts in that node's default workspace and must clone what it needs; managed VMs hold no credentials or private checkouts.\",\n          \"type\": \"string\"\n        },\n        \"request_merge_authority\": {\n          \"description\": \"Request final guarded merge capability for a dedicated integrator. This is not self-authorization: the trusted Hermes client grants it only when github_pr matches the operator-configured repository allowlist.\",\n          \"type\": \"boolean\"\n        },\n        \"supersedes_mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tags\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Track/workstream (e.g. \\\"core-c3\\\").\",\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        },\n        \"writer\": {\n          \"description\": \"Capability boundary for the associated PR. Use false for every reviewer/certifier (server-enforced read-only git/gh); use true for any branch, comment, thread, approval, or merge mutation. Concurrent writers for one PR are rejected.\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"prompt\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"consult_model\",\n    \"description\": \"Ask another model a question (review, second opinion, very hard read-only question) without hand-building a mission. Creates a child mission in the caller's project, on the caller's machine and workspace, with backend=opencode, model_override=<provider>/<model> and writer=false (pr-readonly) unless read_only=false. `model` is a full <provider>/<model> id or a short alias (gpt-6-astra, fable-5.2, opus-5.5); unknown or ambiguous names are rejected with the valid ids. It returns {mission_id} at once and never waits: poll get_consult_result(mission_id) until it returns the answer. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"files\": {\n          \"description\": \"Paths (in the shared workspace) the consultant must read.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"github_pr\": {\n          \"description\": \"PR under review (owner/repo#123), if any.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"model\": {\n          \"description\": \"<provider>/<model> (e.g. openai/gpt-6-astra) or a short alias (gpt-6-astra, fable-5.2, opus-5.5).\",\n          \"type\": \"string\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Injected by the Hermes plugin when present; never invent one.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Defaults to the calling mission's project.\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"description\": \"The question, with all context the consultant needs.\",\n          \"type\": \"string\"\n        },\n        \"read_only\": {\n          \"description\": \"Default true (writer=false, pr-readonly). false lets the consultant write.\",\n          \"type\": \"boolean\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"model\",\n        \"question\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_consult_result\",\n    \"description\": \"Read the outcome of a consult_model mission without waiting: {status, done} while it runs, plus the consultant's final answer once it is no longer pending/active. Poll it (e.g. every minute) instead of blocking.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"send_message_to_mission\",\n    \"description\": \"Send a follow-up to an existing native or cloud mission. Core derives a stable message identity from the action key. Use answer_mission_question for a pending agent question; ordinary follow-ups may queue behind it. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"cloud_model\": {\n          \"description\": \"Model for this cloud turn only. Discover supported models before selecting.\",\n          \"type\": \"string\"\n        },\n        \"cloud_model_params\": {\n          \"items\": {\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"value\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"value\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"content\": {\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"ask_mission\",\n    \"description\": \"Ask a read-only question to a mission's Ask copilot (a sidecar with bash + workspace access) WITHOUT disturbing the mission or waking its main agent. Use this to inspect a mission's workspace/state or get analysis. Returns the copilot's answer and a thread_id; pass thread_id back to continue the same conversation. This does NOT send a message to the mission agent — use send_message_to_mission for that. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"content\": {\n          \"description\": \"The question for the copilot.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"sandbox\": {\n          \"description\": \"Optional: isolate bash writes in a throwaway copy of the workspace (default false).\",\n          \"type\": \"boolean\"\n        },\n        \"thread_id\": {\n          \"description\": \"Optional: continue an existing Ask thread.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"answer_mission_question\",\n    \"description\": \"Answer a mission's pending AskUserQuestion so its blocked turn resumes immediately. A mission parked on a question cannot be unblocked with send_message_to_mission — plain messages QUEUE BEHIND the blocked turn — so this is the way a controller answers instead of leaving the mission in awaiting_user. `answers` is an array of arrays: one inner array per question, each entry an option label (preferred) or free text. Omit tool_call_id to auto-target the mission's single unanswered question; if several are pending you get an error listing them. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"answers\": {\n          \"description\": \"One inner array per question, e.g. [[\\\"Option A\\\"]].\",\n          \"items\": {\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tool_call_id\": {\n          \"description\": \"Optional: the AskUserQuestion tool_call id to answer. Omit to use the newest unanswered one.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"answers\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_mission\",\n    \"description\": \"Request cancellation of a running or pending mission. Acceptance is not proof of termination. Follow the receipt's next_tool: get_cloud_execution for provider confirmation, or get_mission_health for native runner termination. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"acknowledge_mission\",\n    \"description\": \"Acknowledge a mission only after independently verifying its terminal result. This is the safe host-authenticated replacement for asking a workspace container to use the service JWT. It accepts awaiting_user missions whose awaiting_kind is ack, and failed/interrupted missions once you have relayed or abandoned their work (prefer start_mission with supersedes_mission_id for a relay); decision waits and live missions are refused. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"adopt_mission\",\n    \"description\": \"Re-point a mission's origin to THIS conversation so its completion callback lands here. Use when you are waiting on a mission that was dispatched from another session (or with no origin): without adoption, its terminal webhook pins into the conversation that started it — or nowhere — and this conversation is never woken. After adopting, do not poll: the mission-complete callback will arrive as a delivery in this conversation. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_compute_fleet\",\n    \"description\": \"Get a compact live view of sandboxed.sh compute capacity: remote node health, labels, Lean readiness/toolchains, available slots, active/queued jobs, and recent placement receipts. Use this before dispatching parallel compute or choosing a remote validation node. Ordinary CPU/Lean work should prefer non-GPU nodes while they have immediate capacity; request the gpu label only for GPU work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_projects\",\n    \"description\": \"List the projects you supervise (the authoritative roster): slug, status, mode (active/blocked/paused), how many consecutive ticks in that mode, and the next action. Read this at the start of a tick instead of scanning tracker files.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project\",\n    \"description\": \"Get one project's compact snapshot: slug, mode, next_action, blocker, grant, pending operator steers, open decisions, bound conversation, and the highest-priority items (live / awaiting / recent unabsorbed attempts). `items` are the durable work — do not treat the mission list as the inventory. Pending steers outrank “nothing to do”. The snapshot is capped (see items_omitted / item_counts); call list_missions with a track filter for one item. Prefer this over an unfiltered list_missions and over markdown trackers.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"description\": \"Project slug, e.g. 'verity' or 'coldcard-rng-cracker'.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_situation\",\n    \"description\": \"One bounded read of a project's plan: `summary` (total, verified_satisfied, claim_only, open, blocked, live_attempts, source_unavailable, cursor), `steers` (pending operator orders for this tick, plus last consumed), and every track with its derived_state (ready | executing | waiting | blocked | satisfied | claim_only | cancelled), origin (declared | absorbed), owner attempt, and title. Read pending steers first — they outrank “nothing to do” / [SILENT]. This is the only progress number to quote; do not recount items yourself. `claim_only` tracks were marked done without evidence — never report them as verified. An unchanged `cursor` since your last tick means nothing moved. Steers are not standing authority; the grant still wins.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"description\": \"Project slug or alias.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_project_status\",\n    \"description\": \"Report your project's state for this tick: mode (active | blocked | paused), the next action, and the blocker if any. Replaces the [CTRL:] trailer with a structured write; the store counts how long you have been in this mode, so blocked/paused staleness is visible without parsing your reports. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"blocker\": {\n          \"description\": \"What you are blocked on. Set only when mode=blocked.\",\n          \"type\": \"string\"\n        },\n        \"consumed_steer_ids\": {\n          \"description\": \"IDs from steers.pending that this tick actually read and handled. Omit to leave all pending.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mode\": {\n          \"enum\": [\n            \"active\",\n            \"blocked\",\n            \"paused\"\n          ],\n          \"type\": \"string\"\n        },\n        \"next_action\": {\n          \"description\": \"The next concrete step, or the resume/unblock condition.\",\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"mode\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"set_project_track\",\n    \"description\": \"Declare or update one workstream using the validated lifecycle. This cannot mark a track satisfied without accepted criterion evidence and cannot reopen a satisfied track; use accept_project_track_evidence or reopen_project_track for those transitions. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"desired_state\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"enum\": [\n            \"planned\",\n            \"ready\",\n            \"executing\",\n            \"waiting\",\n            \"blocked\",\n            \"satisfied\",\n            \"cancelled\"\n          ],\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_project_track_evidence\",\n    \"description\": \"Accept immutable evidence for one track criterion. The server derives satisfaction only when every current criterion has accepted evidence at the governed artifact version; a mission self-report alone is not evidence. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"artifact_version\": {\n          \"description\": \"Immutable governed version, normally a full commit SHA.\",\n          \"type\": \"string\"\n        },\n        \"criterion\": {\n          \"description\": \"Exact acceptance criterion. May be omitted for a zero- or one-criterion track.\",\n          \"type\": \"string\"\n        },\n        \"evidence_ref\": {\n          \"description\": \"Immutable receipt/URL/commit/job/review reference.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"observed_at\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        },\n        \"verifier_class\": {\n          \"enum\": [\n            \"external_state\",\n            \"command\",\n            \"review\",\n            \"operator\",\n            \"manual\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"verifier_class\",\n        \"evidence_ref\",\n        \"artifact_version\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"reopen_project_track\",\n    \"description\": \"Explicitly reopen a satisfied or cancelled track. Requires a reason, records the authenticated actor, increments the contract revision, and prevents old evidence from satisfying the new revision. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"governed_artifact_version\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"reason\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_project_track\",\n    \"description\": \"Satisfy a track with evidence — the ONLY way a track becomes satisfied (set_project_track rejects done/closed). Pass one evidence entry per declared acceptance criterion (criterion_id = the criterion text or c1, c2, …; omit when the track declares none). Each entry names an immutable handle: kind pr_merged | pr_head_review | review with subject_id 'owner/repo#233@<head sha>', or command / external_state / operator / manual with a job id, commit, or named decision. Head-bound evidence is invalidated automatically when the PR head moves. Use a stable idempotency_key per acceptance (retry-safe); pass expected_revision from get_situation to detect concurrent edits (409 on mismatch). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"evidence\": {\n          \"items\": {\n            \"properties\": {\n              \"criterion_id\": {\n                \"type\": \"string\"\n              },\n              \"kind\": {\n                \"enum\": [\n                  \"pr_merged\",\n                  \"pr_head_review\",\n                  \"review\",\n                  \"command\",\n                  \"external_state\",\n                  \"operator\",\n                  \"manual\"\n                ],\n                \"type\": \"string\"\n              },\n              \"payload\": {\n                \"type\": \"object\"\n              },\n              \"subject_id\": {\n                \"description\": \"Immutable handle, e.g. 'lfglabs-dev/verity#233@20494801f6e2'.\",\n                \"type\": \"string\"\n              },\n              \"verifier\": {\n                \"description\": \"Who or what verified it (reviewer, check name, mission id).\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"kind\",\n              \"subject_id\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"expected_revision\": {\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"idempotency_key\",\n        \"evidence\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"invalidate_project_track_evidence\",\n    \"description\": \"Withdraw one piece of evidence on a track (receipt_id from get_situation / the track's receipts) with a reason. Appends an invalidate receipt; the track reopens if no other evidence stands. Use when a certification turned out wrong or the governed artifact changed in a way the watcher cannot see. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"receipt_id\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"receipt_id\",\n        \"reason\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project_grant\",\n    \"description\": \"Read your project's autonomy grant: merge authority (full | repo:… | review-first), budget per tick, parallel missions, and the structured PAUSED(pause_reason; resume_condition). This is the durable source of what you are authorized to do — it survives prompt rewrites. Read it at your first tick.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"add_project_steer\",\n    \"description\": \"Queue a one-off operator order for the project's next controller tick. Pending steers appear on get_situation / get_project and outrank “nothing to do”; acknowledge only handled IDs using update_project_status.consumed_steer_ids. This is not a grant — standing authority still uses set_project_grant. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"body\": {\n          \"description\": \"What the next tick must acknowledge and act on.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"body\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"record_project_decision\",\n    \"description\": \"Write to the project's decision ledger. Two uses: (1) declare an autonomous act BEFORE doing it (authority=granted, status=decided, kind, evidence with pr_url/mission_id) — if the response says coerced=true your grant does not cover it, treat it as an escalation and do NOT execute; (2) ask the owner a question (authority=escalation or just omit the new fields — the legacy shape still means 'ask'). Non-blocking either way. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"authority\": {\n          \"enum\": [\n            \"granted\",\n            \"escalation\"\n          ],\n          \"type\": \"string\"\n        },\n        \"evidence\": {\n          \"description\": \"Supporting links, e.g. {\\\"pr_url\\\": ..., \\\"mission_id\\\": ...}.\",\n          \"type\": \"object\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"description\": \"merge | dispatch | abandon | pause | resume | scope | budget | retry | ...\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"description\": \"The question for the owner, or the past-tense statement of the act ('Merged verity#2213').\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"enum\": [\n            \"decided\",\n            \"pending_user\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"question\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"answer_project_decision\",\n    \"description\": \"Resolve a pending owner escalation in a project's decision ledger with the owner's answer. Use only when relaying a decision the owner actually expressed. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"answer\": {\n          \"type\": \"string\"\n        },\n        \"at\": {\n          \"description\": \"The decision's 'at' timestamp key from get_project/record_project_decision.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"at\",\n        \"answer\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project_tasks\",\n    \"description\": \"The project's roadmap: every board task planned under the project's boss missions, with status, dependencies, result digest, PR link, and worker mission. Read this to see what is done/running/failed across the whole project without walking individual mission boards.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"plan_project_tasks\",\n    \"description\": \"Declare or revise project tracks. These rows are the only roadmap denominator. Re-planning preserves terminal lifecycle and current evidence; use explicit reopen for terminal work. Set position when the operator declares an exact sequence. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"tasks\": {\n          \"items\": {\n            \"properties\": {\n              \"acceptance_criteria\": {\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"depends_on\": {\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"position\": {\n                \"description\": \"Optional zero-based declarative order. Omission preserves an existing position or appends a new track.\",\n                \"minimum\": 0,\n                \"type\": \"integer\"\n              },\n              \"prompt\": {\n                \"description\": \"What a worker should actually do, if known.\",\n                \"type\": \"string\"\n              },\n              \"task_key\": {\n                \"description\": \"Stable kebab-case key, unique within the project.\",\n                \"type\": \"string\"\n              },\n              \"title\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"task_key\",\n              \"title\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"tasks\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_project_task\",\n    \"description\": \"Edit an open roadmap proposal (title, prompt, acceptance criteria, dependencies). Only proposals are editable — once a boss mission plans the key as a real board task, edits flow through that mission. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"acceptance_criteria\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"depends_on\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"task_key\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_project_task\",\n    \"description\": \"Cancel an open roadmap proposal. Board tasks already adopted by a boss mission are not touched — cancel those through the mission's own board. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"task_key\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"link_mission_to_project\",\n    \"description\": \"Tag a mission as belonging to your project (and optionally a track), so it appears in the project's inventory. Optional writer=false persists read-only capability, including when no PR is attached; writer=true requests writer capability through the existing ownership checks. Capability or assignment changes require stopped, drained work; Pending work must be cancelled first and resumed on the same mission after the update. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        },\n        \"writer\": {\n          \"description\": \"Explicit capability update. False persists read-only; true requests writer ownership. Omit to preserve existing behavior.\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"slug\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_workspaces\",\n    \"description\": \"List sandboxed.sh workspaces so new missions can target the right environment.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace\",\n    \"description\": \"Get the complete configuration and current build status of one sandboxed.sh workspace.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"workspace_id\": {\n          \"description\": \"Workspace UUID.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"workspace_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_workspace_templates\",\n    \"description\": \"List reusable sandboxed.sh workspace templates from the Library.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace_template\",\n    \"description\": \"Get a reusable workspace template. Sensitive values are redacted from the tool result.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"start_workspace_job\",\n    \"description\": \"Start a restart-safe long-running command in a workspace and return immediately with a durable job id. Supply exactly one of command or argv. Retries must reuse the same idempotency_key; a reused key cannot submit duplicate work. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"argv\": {\n          \"description\": \"Argument vector, safely shell-quoted. Mutually exclusive with command.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"command\": {\n          \"description\": \"Shell command. Mutually exclusive with argv.\",\n          \"type\": \"string\"\n        },\n        \"cwd\": {\n          \"description\": \"Working directory relative to the workspace root.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"resource_class\": {\n          \"description\": \"Scheduling hint such as lean_heavy, cpu, or io.\",\n          \"type\": \"string\"\n        },\n        \"timeout_secs\": {\n          \"description\": \"Absolute runtime limit. Default 7200 seconds, maximum 86400.\",\n          \"type\": \"integer\"\n        },\n        \"workspace_id\": {\n          \"description\": \"Workspace UUID. Defaults to the assistant default workspace.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace_job\",\n    \"description\": \"Inspect a durable workspace job by id, including heartbeat, deadline, scope, exit status, and bounded stdout/stderr tails.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"job_id\": {\n          \"type\": \"string\"\n        },\n        \"tail_bytes\": {\n          \"description\": \"Maximum bytes from each log, default 16384, maximum 65536.\",\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"job_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_workspace_job\",\n    \"description\": \"Idempotently request cancellation of a durable workspace job. Returns after cancellation is recorded; process teardown continues asynchronously. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_health\",\n    \"description\": \"Diagnose where a mission stands: live run state, stall severity, detected error signals (rate limit / auth / capacity / context-limit / network), suspected tool loops, the last assistant message, and a one-line recommendation. Use this first when babysitting a long-running mission — it summarizes 'where it is struggling' instead of making you read raw events. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_diagnostics\",\n    \"description\": \"Deep-dive a mission: recent tool calls, deduplicated result snippets, per-tool counts, repeated calls, and bounded error summaries. Use get_mission_events for raw receipts. Use when get_mission_health flags a problem and you need to see exactly what the model is doing.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Trace events to scan from the tail, default 80, max 300.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_mission_settings\",\n    \"description\": \"Change a mission's run settings for its NEXT turn: switch backend (claudecode/codex/opencode/antigravity/grok/vibe), model, reasoning effort, fast mode, or agent. On a failed or interrupted mission the server resumes it on the new settings automatically (resume_queued in the response) — a handoff is one call, no separate resume_mission. Applies between turns — the mission must be idle (awaiting_user/acknowledged/interrupted/failed), not actively running. If it is running, cancel_mission first (or wait), then update, then send_message_to_mission or resume_mission to kick the next turn. model_effort applies to claudecode/codex; fast_mode applies only to Codex GPT-5.6/5.5/5.4 and consumes ChatGPT credits faster. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"agent\": {\n          \"description\": \"Agent name. Omission preserves it on the same backend and clears it on a backend switch. Empty string clears it.\",\n          \"type\": \"string\"\n        },\n        \"backend\": {\n          \"enum\": [\n            \"opencode\",\n            \"claudecode\",\n            \"codex\",\n            \"grok\",\n            \"antigravity\",\n            \"vibe\"\n          ],\n          \"type\": \"string\"\n        },\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"fast_mode\": {\n          \"description\": \"Enable or disable Codex fast mode for future turns. Only backend=codex with GPT-5.6/5.5/5.4.\",\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"model_effort\": {\n          \"enum\": [\n            \"low\",\n            \"medium\",\n            \"high\",\n            \"xhigh\",\n            \"max\"\n          ],\n          \"type\": \"string\"\n        },\n        \"model_override\": {\n          \"description\": \"Model id. Empty string clears it. When backend changes this is reset unless set explicitly.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"resume_mission\",\n    \"description\": \"Resume an interrupted, blocked or failed mission. Bound Codex missions reattach to the same native thread, cwd, HOME and account; existing native goals preserve their objective, token budget and accumulated usage. Grok resumes its recorded native session; a first handoff creates a Grok session while preserving other harness identities. For a mission parked in awaiting_user or acknowledged, send_message_to_mission wakes it on the same id and is the normal choice. Pass `content` as the exact current steering input; on a bound native goal it steers that goal's turn. A new Codex /goal objective must be at most 4000 Unicode characters; oversized objectives are rejected without truncation. Without `content`, persisted Codex goal missions resume the full stored /goal objective; other missions receive the default continue-where-you-left-off prompt. Native blocked/paused/usageLimited/budgetLimited stops park as blocked with terminal_reason=native_goal_stopped after the final response drains; they never mean goal completion. Resolve the reported stop before resuming. codex_continuity_required or native_continuity_required means native identity/history or a tool outcome requires reconciliation: do not repeat identical resumes, change accounts, or assume a fresh thread or reset budget. Queued steering retains its durable order; unconfirmed native delivery is reported explicitly. For existing work with excluded/collaborating PR references, read get_mission and pass continue_identity with the exact stored project, track and github_pr (null if unset). For different work use explicit github_pr/track identity updates instead; ownership checks still apply. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"clean_workspace\": {\n          \"description\": \"Wipe the work directory before resuming. Rarely needed; default false.\",\n          \"type\": \"boolean\"\n        },\n        \"content\": {\n          \"description\": \"Optional steering message used as the resume turn's prompt.\",\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"plan_tasks\",\n    \"description\": \"PREFERRED orchestration tool. Register tasks on this mission's task board. The server-side scheduler then owns everything mechanical: it spawns a worker mission for every dependency-satisfied task while capacity allows, retries failures once, and MESSAGES YOU A DIGEST as each task settles. You never create workers, wait, or poll. Specify each task by its OUTCOME, not its procedure: acceptance_criteria + verification_command are the contract (the weakest testable conditions that define success — any approach satisfying them is an acceptable delivery); the prompt supplies scope, absolute paths, and context, and its suggested approach is advisory. Each task needs: task_key (stable, unique), title, prompt, backend (codex/opencode/grok — never claudecode), acceptance_criteria + verification_command (strongly recommended; tasks without either get a spec_warnings entry), and optionally risk_class (high = never retried silently), model_override/model_effort, depends_on (keys of tasks that must settle successfully first — unknown keys park the task and raise unresolvable_deps), and worktree {path, branch, base} for an isolated checkout (created here, before registration). Re-calling with an existing key updates the task while it is still pending. After planning: END YOUR TURN — digests will wake you. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"tasks\": {\n          \"items\": {\n            \"properties\": {\n              \"acceptance_criteria\": {\n                \"description\": \"Objective, testable conditions that define success — the weakest set that still guarantees the outcome. Delivered to the worker as the authoritative contract\",\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"backend\": {\n                \"description\": \"codex | opencode | grok (never claudecode)\",\n                \"type\": \"string\"\n              },\n              \"depends_on\": {\n                \"description\": \"task_keys that must settle successfully or be accepted first\",\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"model_effort\": {\n                \"description\": \"low | medium | high | xhigh | max (codex)\",\n                \"type\": \"string\"\n              },\n              \"model_override\": {\n                \"description\": \"Exact account-supported model ID. For Codex Terra use gpt-5.6-terra with medium effort. Never invent variants such as gpt-5.5-sol.\",\n                \"type\": \"string\"\n              },\n              \"prompt\": {\n                \"description\": \"Worker prompt: exact scope, absolute paths, context. Suggested approach is advisory — the acceptance criteria define success\",\n                \"type\": \"string\"\n              },\n              \"risk_class\": {\n                \"description\": \"low | normal (default) | high. high = a failed attempt is never retried silently; it settles for your review\",\n                \"type\": \"string\"\n              },\n              \"task_key\": {\n                \"description\": \"Stable unique key on this board (e.g. 'p3-nonce')\",\n                \"type\": \"string\"\n              },\n              \"title\": {\n                \"type\": \"string\"\n              },\n              \"verification_command\": {\n                \"description\": \"Command whose success verifies the task; the worker must run it before DELIVERED\",\n                \"type\": \"string\"\n              },\n              \"working_directory\": {\n                \"description\": \"Worker cwd; superseded by worktree.path if a worktree is given\",\n                \"type\": \"string\"\n              },\n              \"worktree\": {\n                \"properties\": {\n                  \"base\": {\n                    \"description\": \"Base branch/commit (default HEAD)\",\n                    \"type\": \"string\"\n                  },\n                  \"branch\": {\n                    \"type\": \"string\"\n                  },\n                  \"path\": {\n                    \"description\": \"Absolute worktree path (inside the workspace)\",\n                    \"type\": \"string\"\n                  },\n                  \"repo_path\": {\n                    \"description\": \"Repo owning the worktree (auto-detected if omitted)\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\",\n                  \"branch\"\n                ],\n                \"type\": \"object\"\n              }\n            },\n            \"required\": [\n              \"task_key\",\n              \"title\",\n              \"prompt\",\n              \"backend\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"tasks\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"board_status\",\n    \"description\": \"Current task board: every task with status (pending/running/settled/accepted/failed/cancelled), outcome, worker mission id, digest, plus utilization counters and unresolvable_deps (tasks parked forever on a depends_on key that doesn't exist — fix by re-registering via plan_tasks). Cheap snapshot — use instead of list_worker_missions/get_worker_status for board work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"review_task\",\n    \"description\": \"Full review payload for a board task: the task record (prompt, digest, notes) plus the tail of the worker mission's conversation. Use before accept_task/reject_task when the digest alone isn't enough to judge. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"history_limit\": {\n          \"description\": \"Worker history entries to include (default 6)\",\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"description\": \"Task UUID (alternative)\",\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"description\": \"Task key on this board (preferred)\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_task\",\n    \"description\": \"Accept a settled task's result (terminal verdict). Unblocks nothing extra — successful settles already unblock dependents — but records your judgment and clears the awaiting-verdict queue. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"reject_task\",\n    \"description\": \"Reject a settled (or failed) task with feedback. The worker mission is resumed with your feedback so it keeps its context; if the worker is gone the task is re-queued with the feedback appended to its prompt. Feedback should be the MINIMAL added constraint: a concrete counterexample or a new acceptance criterion that excludes the observed failure — not a prescription of how to redo the work. Judge results on whether they satisfy the acceptance criteria/verification, never on whether the worker followed the approach you imagined. You'll get a fresh digest when it settles again. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"feedback\": {\n          \"description\": \"What is wrong and what to change — delivered verbatim to the worker\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"feedback\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"delay_seconds\": {\n          \"maximum\": 3600,\n          \"minimum\": 60,\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"delay_seconds\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_job_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_search_knowledge\",\n    \"description\": \"Search curated Hindsight knowledge pages (`thomas` or `ppl` bank) via Core's governed memory broker. Returns matching page titles, paths, and excerpts in one round-trip without exposing raw API keys to the worker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` for general personal/project context, `ppl` for people/relationships; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"limit\": {\n          \"description\": \"Maximum results to return (1..=25, default 10).\",\n          \"maximum\": 25,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Search query keywords or phrase.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_page\",\n    \"description\": \"Read a full curated Hindsight knowledge page by `path` (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Knowledge page path returned by `memory_search_knowledge` or `memory_get_knowledge_tree`.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_tree\",\n    \"description\": \"List the curated Hindsight knowledge directory tree (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Optional subtree prefix to inspect.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_recall\",\n    \"description\": \"Recall raw episodic memories from Hindsight (`thomas` or `ppl` bank) when curated knowledge pages (`memory_search_knowledge`) do not yet cover a topic.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Memory bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"max_tokens\": {\n          \"description\": \"Token budget for recalled memories (1..=8192, default 4096).\",\n          \"maximum\": 8192,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Natural-language recall query.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  }\n]"

def operatorCatalogPrettyJson : String :=
  "[\n  {\n    \"name\": \"get_capabilities\",\n    \"description\": \"Read the authenticated identity, effective role, contract version, tools and limits. No work is started.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_action\",\n    \"description\": \"Read an accepted action receipt and its result. A pending or uncertain action must never be submitted with a new key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"action_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"action_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_action\",\n    \"description\": \"Cancel an action that is still queued. Returns a durable cancellation receipt. Once dispatch started, cancellation is not claimed: inspect the target and use cancel_mission or cancel_workspace_job.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"action_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"action_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"reconcile_action\",\n    \"description\": \"Operator-only: after inspecting the target, record evidence that an uncertain action completed or never took effect. This settles the original receipt without replaying work. Use the original mission/project session scope.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"action_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"evidence\": {\n          \"maxLength\": 4096,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"resolution\": {\n          \"enum\": [\n            \"completed\",\n            \"rejected\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"action_id\",\n        \"resolution\",\n        \"evidence\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"create_worktree\",\n    \"description\": \"Create a Git worktree inside the mission workspace on its current machine. Paths are relative to the mission root. Specify repo_path when the checkout is in a subdirectory.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"base\": {\n          \"type\": \"string\"\n        },\n        \"branch\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"type\": \"string\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"branch\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"remove_worktree\",\n    \"description\": \"Remove a clean worktree inside the mission workspace on its current machine. Dirty worktrees are preserved; forced removal is not supported.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"type\": \"string\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"merge_branch\",\n    \"description\": \"Merge in the mission workspace on its current machine. The checkout must be clean and already on target_branch. Conflicts are reported and the merge is aborted; assign a resolver after inspecting the receipt. Optional source deletion only removes fully merged branches.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"delete_source\": {\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"push\": {\n          \"type\": \"boolean\"\n        },\n        \"repo_path\": {\n          \"type\": \"string\"\n        },\n        \"source_branch\": {\n          \"type\": \"string\"\n        },\n        \"target_branch\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"source_branch\",\n        \"target_branch\",\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_list\",\n    \"description\": \"List the names (never values) of Thomas's secrets: which ones this mission can read now, and which need his approval, grouped by Bitwarden project.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_get\",\n    \"description\": \"Get one secret by name. Secrets in this project's default Bitwarden projects come back at once; others ask Thomas (Touch ID / Face ID) and wait up to 20 s, then return `pending` — call again later. The value is written to a private file; the result gives its path and an `export` line. Never print the value or paste it into chat, commits or logs.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Why the mission needs it; shown to Thomas.\",\n          \"maxLength\": 500,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_request\",\n    \"description\": \"Ask Thomas for read access to a whole Bitwarden project (by name), or `all`, for this mission. Waits up to 20 s for approval, then returns `pending`.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_put\",\n    \"description\": \"Store a secret (create, or update the value) in a Bitwarden project. Always needs Thomas's approval; waits up to 20 s, then returns `pending`. Use UPPER_SNAKE_CASE names and the project that fits (see secret_list for project names).\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"note\": {\n          \"maxLength\": 2000,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"maxLength\": 65536,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"value\",\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_delete\",\n    \"description\": \"Permanently delete a secret from Bitwarden. Always needs Thomas's approval; waits up to 20 s, then returns `pending` — call again later. If the same name exists in several projects, pass `bitwarden_project` to pick which copy to delete. To rename a secret: secret_get the old name, secret_put the new one, then secret_delete the old one.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"description\": \"Project holding the copy to delete; only needed when the name is duplicated.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"secret_move\",\n    \"description\": \"Move a secret (value and note unchanged) to another Bitwarden project. Always needs Thomas's approval; waits up to 20 s, then returns `pending` — call again later.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bitwarden_project\": {\n          \"description\": \"Destination project.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"bitwarden_project\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"request_mission_access\",\n    \"description\": \"Ask Thomas for read-only access to another mission that you did not start and that is not in your tree (when get_mission / get_mission_events answer \\\"outside this session's scope\\\"). He approves on his device with Touch ID / Face ID. Waits up to 20 s, then returns `pending`; you get a message when he decides, or call list_mission_access. Once approved (default 24 h), get_mission, get_mission_events, get_mission_health and list_mission_shared_files work on that mission. Never grants control: sending messages, cancel, resume and placement stay denied.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"reason\": {\n          \"description\": \"Why you need it; shown to Thomas.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"scope\": {\n          \"default\": \"read\",\n          \"enum\": [\n            \"read\"\n          ],\n          \"type\": \"string\"\n        },\n        \"target_mission_id\": {\n          \"description\": \"Full UUID of the mission to read.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"ttl_hours\": {\n          \"description\": \"How long you need it (default 24).\",\n          \"maximum\": 168,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"target_mission_id\",\n        \"reason\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_mission_access\",\n    \"description\": \"List this mission's access requests to other missions and their status (pending, approved with expiry, denied, expired, revoked).\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"spawn_managed_machine\",\n    \"description\": \"Rent a fresh, disposable cloud VM (boat.dev, EU) and enroll it as a compute node, so you can run a subagent or heavy job on dedicated CPU/RAM instead of sharing the fleet. Use this whenever a task needs more compute than you have (parallel builds, big test suites, memory-hungry Lean/Rust/ML work, isolation from the shared nodes) or get_compute_fleet shows no free capacity. You choose the size: small = 2 vCPU / 4 GB RAM / 12 GB disk ($0.018/h, default), default = 4 vCPU / 8 GB / 50 GB ($0.036/h), large = 8 vCPU / 16 GB / 125 GB ($0.072/h), xlarge = 16 vCPU / 32 GB / 251 GB ($0.20/h); or pass cpu and/or ram_gb and the smallest fitting size is picked. The VM comes with claude, codex, opencode, gemini, agy, elan/Lean v4.35.0, turbo-lean, lean-native and certified-search, but NO credentials and no private checkouts (it is an untrusted, managed trust class: never send secrets, tokens or credentials there; private repository source may be built there only when the operator has explicitly authorized it for this mission, delivered as a git bundle or attachment from a trusted node and never by placing a token on the VM). Result (via get_action) has its short `name` (e.g. small-a, large-b): start a subagent there with start_mission(remote_node_id=name, backend=..., prompt=...). Shortcut: start_mission(remote_node_id=\\\"auto-managed:<size>\\\") spawns and places in one call. All sizes run the same CPU (AMD Ryzen 9 9950X, Zen 5, AVX-512, VPCLMULQDQ): size buys cores and RAM, not CPU features, so use small or default for probes and audits. Every machine has a TTL (default 60 min, auto-extended in 30 min chunks while busy, max 720) and is destroyed a few minutes after your mission ends, 15 idle minutes after it is interrupted or waiting, or at its TTL. It is charged to your mission's budget pool if one is set (see get_budget). Call destroy_managed_machine as soon as you are done. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"cpu\": {\n          \"description\": \"Minimum vCPUs needed (alternative to size).\",\n          \"maximum\": 16,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"from_snapshot\": {\n          \"description\": \"Start from one of your project's snapshots (list_managed_snapshots) with repos, toolchains and caches ready.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"image\": {\n          \"description\": \"Image (named snapshot). Default orb-node-base.\",\n          \"type\": \"string\"\n        },\n        \"ram_gb\": {\n          \"description\": \"Minimum RAM in GB needed (alternative to size).\",\n          \"maximum\": 32,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"reason\": {\n          \"description\": \"Why you need it (shown to the operator and in the cost ledger).\",\n          \"type\": \"string\"\n        },\n        \"size\": {\n          \"description\": \"small=2 vCPU/4 GB, default=4 vCPU/8 GB, large=8 vCPU/16 GB, xlarge=16 vCPU/32 GB. Omit to use cpu/ram_gb or the default (small).\",\n          \"enum\": [\n            \"small\",\n            \"default\",\n            \"large\",\n            \"xlarge\"\n          ],\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"description\": \"Initial lifetime; auto-extended while busy (within budget). Default 60.\",\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_managed_machines\",\n    \"description\": \"List live managed VMs (boat.dev) compactly: name, size, state, owner, expires_at, reap_at, cost so far, plus today's spend, running count and caps (null = unlimited). Pass verbose=true for full rows and the last 24 h of destroyed machines. Check this before spawning to reuse a machine you already own.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"verbose\": {\n          \"description\": \"Full rows and history (large).\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"snapshot_managed_machine\",\n    \"description\": \"Save a named snapshot of a managed VM for your project (warm image: repos cloned, toolchains installed, build caches built). Put state outside /tmp and ~/.cache (snapshots do not keep them). Takes seconds to minutes (status saving -> ready); delivered secrets are removed first. Start children from it with spawn_managed_machine(from_snapshot=name) or start_mission(remote_node_id=\\\"auto-managed:<size>\\\", managed_from_snapshot=name). 10 snapshots are free, then $1.70/month each; Core keeps the newest 2 per project and deletes ones unused for 14 days. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"description\": \"Short label, e.g. lean-native-warm\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_managed_snapshots\",\n    \"description\": \"List your project's managed-VM snapshots: name, label, status, source machine, size, created/last used, monthly storage cost.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"delete_managed_snapshot\",\n    \"description\": \"Delete one of your project's snapshots (refused while a machine is being created from it). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"fork_managed_machine\",\n    \"description\": \"Create a new managed VM from another VM's current state (a subagent starting from your built tree). Boat forks from the latest background snapshot, which can be about a minute stale: write and `sync` what the child needs and wait ~60 s first, or take a named snapshot for an exact copy. Same size unless size is given; budget and caps apply like a new VM. Then start_mission(remote_node_id=<returned name>). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"size\": {\n          \"enum\": [\n            \"small\",\n            \"default\",\n            \"large\",\n            \"xlarge\"\n          ],\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"stop_managed_machine\",\n    \"description\": \"Stop a managed VM you will need again later: billing stops, the disk is kept (resume within 24 h). Prefer this to leaving a VM idle. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"resume_managed_machine\",\n    \"description\": \"Resume a stopped managed VM (same name and node id; files kept, processes restart). Budget and caps apply. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_budget\",\n    \"description\": \"Your mission's managed-VM spending budget: mode (own, pooled from an ancestor, or none = only the daily cap), the pool's budget, spent, reserved (min(TTL, 60 min) of each live VM), held by children's sub-budgets, remaining, the most you may grant a child (start_mission budget_usd), and each child's usage. Spawns, extensions and sub-budgets beyond the remaining amount are refused with budget_exceeded / sub_budget_exceeds_pool.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"destroy_managed_machine\",\n    \"description\": \"Destroy a managed VM you no longer need (stops billing immediately and closes its cost ledger). Idempotent. Pass the machine name (e.g. small-a), id (mm…) or node id (managed-mm…). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"extend_managed_machine\",\n    \"description\": \"Extend a managed VM's TTL by ttl_minutes beyond its current expiry (total lifetime capped at 720 minutes after creation). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"machine_id\": {\n          \"type\": \"string\"\n        },\n        \"ttl_minutes\": {\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"machine_id\",\n        \"ttl_minutes\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_active_missions\",\n    \"description\": \"List active, pending, blocked, or awaiting-user missions in sandboxed.sh. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis. Results are bounded pages. Follow next_offset while non-null, including after an empty filtered page. Concurrent inserts may shift offsets; deduplicate by mission ID.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum missions to return, default 50.\",\n          \"type\": \"integer\"\n        },\n        \"offset\": {\n          \"description\": \"Use the preceding page's next_offset; omit for the first page.\",\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Optional filter: only missions launched from this Hermes conversation.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Optional filter: exact project id.\",\n          \"type\": \"string\"\n        },\n        \"project_prefix\": {\n          \"description\": \"Optional filter: project FAMILY — matches the id and its `-` suffixed variants (e.g. verity covers verity-core, verity-phase1d). Use this when a project's work is still split across per-phase ids.\",\n          \"type\": \"string\"\n        },\n        \"tag\": {\n          \"description\": \"Optional filter: only missions carrying this tag.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Optional filter: exact track within a project.\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_missions\",\n    \"description\": \"List missions on the attention horizon: live, waiting, blocked, and unabsorbed failed/interrupted attempts. Acknowledged, completed, and replaced attempts are omitted unless you pass an explicit status. Filter by project or track to see attempts on one item. Prefer get_project for the item-first inventory. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis. Results are bounded pages. Follow next_offset while non-null, including after an empty filtered page. Concurrent inserts may shift offsets; deduplicate by mission ID.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum missions to return, default 50.\",\n          \"type\": \"integer\"\n        },\n        \"offset\": {\n          \"description\": \"Use the preceding page's next_offset; omit for the first page.\",\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Optional filter: only missions launched from this Hermes conversation.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Optional filter: exact project id.\",\n          \"type\": \"string\"\n        },\n        \"project_prefix\": {\n          \"description\": \"Optional filter: project FAMILY — matches the id and its `-` suffixed variants (e.g. verity covers verity-core, verity-phase1d). Use this when a project's work is still split across per-phase ids.\",\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"description\": \"Optional mission status filter.\",\n          \"type\": \"string\"\n        },\n        \"tag\": {\n          \"description\": \"Optional filter: only missions carrying this tag.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Optional filter: exact track within a project.\",\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission\",\n    \"description\": \"Compatibility alias for the compact ~2KB mission digest. It never returns the full history; use get_mission_events with a bounded limit for transcript or trace details. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_events\",\n    \"description\": \"Fetch persisted mission events. Without a cursor, returns the newest bounded page in ascending order; use before_seq to page backwards or since_seq for deltas.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"before_seq\": {\n          \"description\": \"Page backwards: return the newest events with sequence below this value (takes precedence over since_seq).\",\n          \"type\": \"integer\"\n        },\n        \"limit\": {\n          \"description\": \"Maximum events to return, default 40 newest events.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"since_seq\": {\n          \"description\": \"Return events with sequence greater than this value.\",\n          \"type\": \"integer\"\n        },\n        \"view\": {\n          \"enum\": [\n            \"transcript\",\n            \"trace\",\n            \"history\",\n            \"all\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_mission_shared_files\",\n    \"description\": \"List files and screenshots shared by assistant messages in a sandboxed.sh mission.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Maximum mission events to scan, default 40.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_cloud_models\",\n    \"description\": \"Discover actual hosted model IDs, labels and supported parameter combinations before creating or following up a cloud mission. Grok Bot has no model selector.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"provider\": {\n          \"enum\": [\n            \"chatgpt\",\n            \"cursor_cloud\",\n            \"hermes\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"provider\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_cloud_accounts\",\n    \"description\": \"Discover hosted agent accounts and effective capabilities. Unavailable connectors cannot launch; connecting never starts work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_cloud_execution\",\n    \"description\": \"Read a bounded page of durable hosted turns, external identities and results. Defaults to the latest turn and 4096 characters per result/detail; prompts are omitted. Pass offset=0 to read from the beginning. Follow page.next_offset for subsequent turns. To continue text, select that turn with offset and limit=1, then pass its text_slices field's next_offset as text_offset. Character offsets are Unicode scalar values. Poll the last unfinished turn again until terminal; revision changes as execution advances. Artifact/branch payloads are omitted; counts are included. Transport loss is not completion.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"include_prompt\": {\n          \"type\": \"boolean\"\n        },\n        \"limit\": {\n          \"maximum\": 5,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"offset\": {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        \"text_limit\": {\n          \"maximum\": 8192,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"text_offset\": {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"start_mission\",\n    \"description\": \"Launch one native or cloud mission. Native launches select a backend/workspace/model; cloud launches select cloud.provider/account and optional repository/model. Discover cloud availability with list_cloud_accounts and list_cloud_models. Every role can use owner cloud accounts within quotas. Core supplies the parent identity for executors. Pass project/track and acceptance criteria for governed work; reviewers use writer=false. For a review or second opinion from another model, call consult_model instead. Mission completion and accepted project evidence remain separate. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"acceptance_criteria\": {\n          \"description\": \"Outcome contract used when this dispatch declares the track. Existing satisfied tracks are never reopened implicitly.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"agent\": {\n          \"type\": \"string\"\n        },\n        \"attachments\": {\n          \"description\": \"Ordinary files to materialize under .paloma/ before the harness starts. Not vendor-CLI @ syntax.\",\n          \"items\": {\n            \"properties\": {\n              \"kind\": {\n                \"enum\": [\n                  \"file\",\n                  \"folder\",\n                  \"controller\"\n                ],\n                \"type\": \"string\"\n              },\n              \"path\": {\n                \"description\": \"Project-relative path for file/folder chips.\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"kind\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"backend\": {\n          \"enum\": [\n            \"opencode\",\n            \"claudecode\",\n            \"codex\",\n            \"grok\",\n            \"antigravity\",\n            \"vibe\"\n          ],\n          \"type\": \"string\"\n        },\n        \"budget_usd\": {\n          \"description\": \"Optional managed-VM budget (USD) for the child and its descendants. Under your own budget pool it is a sub-budget carved from it and must not exceed its remaining amount (see get_budget). Omit to let the child share your pool.\",\n          \"minimum\": 0,\n          \"type\": \"number\"\n        },\n        \"cloud\": {\n          \"additionalProperties\": false,\n          \"description\": \"Hosted execution. Discover availability with list_cloud_accounts. Requires idempotency_key; never pass credentials, machine paths or attachments.\",\n          \"properties\": {\n            \"account\": {\n              \"type\": \"string\"\n            },\n            \"git_ref\": {\n              \"type\": \"string\"\n            },\n            \"model\": {\n              \"type\": \"string\"\n            },\n            \"model_params\": {\n              \"items\": {\n                \"properties\": {\n                  \"id\": {\n                    \"type\": \"string\"\n                  },\n                  \"value\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"id\",\n                  \"value\"\n                ],\n                \"type\": \"object\"\n              },\n              \"type\": \"array\"\n            },\n            \"provider\": {\n              \"enum\": [\n                \"chatgpt\",\n                \"grok_bot\",\n                \"cursor_cloud\",\n                \"hermes\"\n              ],\n              \"type\": \"string\"\n            },\n            \"repository\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"provider\",\n            \"account\"\n          ],\n          \"type\": \"object\"\n        },\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"desired_state\": {\n          \"description\": \"Track state, e.g. waiting_ci / waiting_review / blocked_external.\",\n          \"type\": \"string\"\n        },\n        \"estimated_disk_gib\": {\n          \"description\": \"Expected peak local scratch use. Set this for Lean/build-heavy missions; omit for small/no-build work.\",\n          \"maximum\": 512,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"fast_mode\": {\n          \"description\": \"Enable Codex fast mode (service tier fast). Requires backend=codex and an explicit GPT-5.6, GPT-5.5, or GPT-5.4 model_override. Uses ChatGPT credits faster.\",\n          \"type\": \"boolean\"\n        },\n        \"github_pr\": {\n          \"description\": \"Associated PR ref (e.g. \\\"owner/repo#123\\\").\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"intent\": {\n          \"description\": \"Intent (e.g. \\\"review_merge_pr\\\").\",\n          \"type\": \"string\"\n        },\n        \"managed_from_snapshot\": {\n          \"description\": \"Only with remote_node_id auto-managed: start the child's VM from this project snapshot (list_managed_snapshots) instead of the base image, so repos, toolchains and build caches are already there.\",\n          \"type\": \"string\"\n        },\n        \"managed_ttl_minutes\": {\n          \"description\": \"Only with remote_node_id auto-managed: initial machine TTL in minutes (default 60, auto-extended while busy).\",\n          \"maximum\": 720,\n          \"minimum\": 5,\n          \"type\": \"integer\"\n        },\n        \"model_effort\": {\n          \"enum\": [\n            \"low\",\n            \"medium\",\n            \"high\",\n            \"xhigh\",\n            \"max\"\n          ],\n          \"type\": \"string\"\n        },\n        \"model_override\": {\n          \"description\": \"Exact account-supported model ID. For opencode use <provider>/<model> (e.g. openai/gpt-6-astra). For Codex Terra use gpt-5.6-terra with medium effort. Never invent variants such as gpt-5.5-sol. Codex on a remote node (remote_node_id, e.g. auto-managed:default / auto-managed:large) runs through the core proxy: pass model_override explicitly (e.g. gpt-6.1-sol); if omitted, the configured Codex default is used and recorded on the mission.\",\n          \"type\": \"string\"\n        },\n        \"next_check_at\": {\n          \"description\": \"When the track should next be checked (RFC3339).\",\n          \"type\": \"string\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Implementation routing hint (Hermes session id). Injected by the Hermes plugin when present. Controllers should pass project/track instead; completion is a mission row, not a chat callback. Never invent another session's id.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Stable project id (e.g. \\\"verity\\\").\",\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Codex native /goal objective: maximum 4000 Unicode characters, including automatic writer promotion. Put supporting detail in referenced artifacts; never rely on truncation.\",\n          \"type\": \"string\"\n        },\n        \"remote_node_id\": {\n          \"description\": \"Native node placement: a registered node id, \\\"auto\\\" for the fleet scheduler (least-loaded eligible static node), a managed machine's name (\\\"small-a\\\", from spawn_managed_machine) or its node id, or \\\"auto-managed\\\" / \\\"auto-managed:<small|default|large|xlarge>\\\" to rent a boat.dev VM of that size for this child (validated before renting; an idle VM of the same size left by an ended sibling is reused; default small; the child owns it and it is destroyed shortly after the child ends, or at its TTL; call destroy_managed_machine to release it earlier). Omit to inherit the parent's node and workspace. A child placed elsewhere starts in that node's default workspace and must clone what it needs; managed VMs hold no credentials or private checkouts.\",\n          \"type\": \"string\"\n        },\n        \"request_merge_authority\": {\n          \"description\": \"Request final guarded merge capability for a dedicated integrator. This is not self-authorization: the trusted Hermes client grants it only when github_pr matches the operator-configured repository allowlist.\",\n          \"type\": \"boolean\"\n        },\n        \"supersedes_mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tags\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Track/workstream (e.g. \\\"core-c3\\\").\",\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        },\n        \"writer\": {\n          \"description\": \"Capability boundary for the associated PR. Use false for every reviewer/certifier (server-enforced read-only git/gh); use true for any branch, comment, thread, approval, or merge mutation. Concurrent writers for one PR are rejected.\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"prompt\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"consult_model\",\n    \"description\": \"Ask another model a question (review, second opinion, very hard read-only question) without hand-building a mission. Creates a child mission in the caller's project, on the caller's machine and workspace, with backend=opencode, model_override=<provider>/<model> and writer=false (pr-readonly) unless read_only=false. `model` is a full <provider>/<model> id or a short alias (gpt-6-astra, fable-5.2, opus-5.5); unknown or ambiguous names are rejected with the valid ids. It returns {mission_id} at once and never waits: poll get_consult_result(mission_id) until it returns the answer. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"files\": {\n          \"description\": \"Paths (in the shared workspace) the consultant must read.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"github_pr\": {\n          \"description\": \"PR under review (owner/repo#123), if any.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"model\": {\n          \"description\": \"<provider>/<model> (e.g. openai/gpt-6-astra) or a short alias (gpt-6-astra, fable-5.2, opus-5.5).\",\n          \"type\": \"string\"\n        },\n        \"origin_session_id\": {\n          \"description\": \"Injected by the Hermes plugin when present; never invent one.\",\n          \"type\": \"string\"\n        },\n        \"project\": {\n          \"description\": \"Defaults to the calling mission's project.\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"description\": \"The question, with all context the consultant needs.\",\n          \"type\": \"string\"\n        },\n        \"read_only\": {\n          \"description\": \"Default true (writer=false, pr-readonly). false lets the consultant write.\",\n          \"type\": \"boolean\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"model\",\n        \"question\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_consult_result\",\n    \"description\": \"Read the outcome of a consult_model mission without waiting: {status, done} while it runs, plus the consultant's final answer once it is no longer pending/active. Poll it (e.g. every minute) instead of blocking.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"send_message_to_mission\",\n    \"description\": \"Send a follow-up to an existing native or cloud mission. Core derives a stable message identity from the action key. Use answer_mission_question for a pending agent question; ordinary follow-ups may queue behind it. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"cloud_model\": {\n          \"description\": \"Model for this cloud turn only. Discover supported models before selecting.\",\n          \"type\": \"string\"\n        },\n        \"cloud_model_params\": {\n          \"items\": {\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"value\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"value\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"content\": {\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"ask_mission\",\n    \"description\": \"Ask a read-only question to a mission's Ask copilot (a sidecar with bash + workspace access) WITHOUT disturbing the mission or waking its main agent. Use this to inspect a mission's workspace/state or get analysis. Returns the copilot's answer and a thread_id; pass thread_id back to continue the same conversation. This does NOT send a message to the mission agent — use send_message_to_mission for that. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"content\": {\n          \"description\": \"The question for the copilot.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"sandbox\": {\n          \"description\": \"Optional: isolate bash writes in a throwaway copy of the workspace (default false).\",\n          \"type\": \"boolean\"\n        },\n        \"thread_id\": {\n          \"description\": \"Optional: continue an existing Ask thread.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"content\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"answer_mission_question\",\n    \"description\": \"Answer a mission's pending AskUserQuestion so its blocked turn resumes immediately. A mission parked on a question cannot be unblocked with send_message_to_mission — plain messages QUEUE BEHIND the blocked turn — so this is the way a controller answers instead of leaving the mission in awaiting_user. `answers` is an array of arrays: one inner array per question, each entry an option label (preferred) or free text. Omit tool_call_id to auto-target the mission's single unanswered question; if several are pending you get an error listing them. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"answers\": {\n          \"description\": \"One inner array per question, e.g. [[\\\"Option A\\\"]].\",\n          \"items\": {\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"tool_call_id\": {\n          \"description\": \"Optional: the AskUserQuestion tool_call id to answer. Omit to use the newest unanswered one.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"answers\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_mission\",\n    \"description\": \"Request cancellation of a running or pending mission. Acceptance is not proof of termination. Follow the receipt's next_tool: get_cloud_execution for provider confirmation, or get_mission_health for native runner termination. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"acknowledge_mission\",\n    \"description\": \"Acknowledge a mission only after independently verifying its terminal result. This is the safe host-authenticated replacement for asking a workspace container to use the service JWT. It accepts awaiting_user missions whose awaiting_kind is ack, and failed/interrupted missions once you have relayed or abandoned their work (prefer start_mission with supersedes_mission_id for a relay); decision waits and live missions are refused. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"adopt_mission\",\n    \"description\": \"Re-point a mission's origin to THIS conversation so its completion callback lands here. Use when you are waiting on a mission that was dispatched from another session (or with no origin): without adoption, its terminal webhook pins into the conversation that started it — or nowhere — and this conversation is never woken. After adopting, do not poll: the mission-complete callback will arrive as a delivery in this conversation. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_compute_fleet\",\n    \"description\": \"Get a compact live view of sandboxed.sh compute capacity: remote node health, labels, Lean readiness/toolchains, available slots, active/queued jobs, and recent placement receipts. Use this before dispatching parallel compute or choosing a remote validation node. Ordinary CPU/Lean work should prefer non-GPU nodes while they have immediate capacity; request the gpu label only for GPU work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_projects\",\n    \"description\": \"List the projects you supervise (the authoritative roster): slug, status, mode (active/blocked/paused), how many consecutive ticks in that mode, and the next action. Read this at the start of a tick instead of scanning tracker files.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project\",\n    \"description\": \"Get one project's compact snapshot: slug, mode, next_action, blocker, grant, pending operator steers, open decisions, bound conversation, and the highest-priority items (live / awaiting / recent unabsorbed attempts). `items` are the durable work — do not treat the mission list as the inventory. Pending steers outrank “nothing to do”. The snapshot is capped (see items_omitted / item_counts); call list_missions with a track filter for one item. Prefer this over an unfiltered list_missions and over markdown trackers.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"description\": \"Project slug, e.g. 'verity' or 'coldcard-rng-cracker'.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_situation\",\n    \"description\": \"One bounded read of a project's plan: `summary` (total, verified_satisfied, claim_only, open, blocked, live_attempts, source_unavailable, cursor), `steers` (pending operator orders for this tick, plus last consumed), and every track with its derived_state (ready | executing | waiting | blocked | satisfied | claim_only | cancelled), origin (declared | absorbed), owner attempt, and title. Read pending steers first — they outrank “nothing to do” / [SILENT]. This is the only progress number to quote; do not recount items yourself. `claim_only` tracks were marked done without evidence — never report them as verified. An unchanged `cursor` since your last tick means nothing moved. Steers are not standing authority; the grant still wins.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"description\": \"Project slug or alias.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_project_status\",\n    \"description\": \"Report your project's state for this tick: mode (active | blocked | paused), the next action, and the blocker if any. Replaces the [CTRL:] trailer with a structured write; the store counts how long you have been in this mode, so blocked/paused staleness is visible without parsing your reports. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"blocker\": {\n          \"description\": \"What you are blocked on. Set only when mode=blocked.\",\n          \"type\": \"string\"\n        },\n        \"consumed_steer_ids\": {\n          \"description\": \"IDs from steers.pending that this tick actually read and handled. Omit to leave all pending.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mode\": {\n          \"enum\": [\n            \"active\",\n            \"blocked\",\n            \"paused\"\n          ],\n          \"type\": \"string\"\n        },\n        \"next_action\": {\n          \"description\": \"The next concrete step, or the resume/unblock condition.\",\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"mode\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"set_project_track\",\n    \"description\": \"Declare or update one workstream using the validated lifecycle. This cannot mark a track satisfied without accepted criterion evidence and cannot reopen a satisfied track; use accept_project_track_evidence or reopen_project_track for those transitions. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"desired_state\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"enum\": [\n            \"planned\",\n            \"ready\",\n            \"executing\",\n            \"waiting\",\n            \"blocked\",\n            \"satisfied\",\n            \"cancelled\"\n          ],\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_project_track_evidence\",\n    \"description\": \"Accept immutable evidence for one track criterion. The server derives satisfaction only when every current criterion has accepted evidence at the governed artifact version; a mission self-report alone is not evidence. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"artifact_version\": {\n          \"description\": \"Immutable governed version, normally a full commit SHA.\",\n          \"type\": \"string\"\n        },\n        \"criterion\": {\n          \"description\": \"Exact acceptance criterion. May be omitted for a zero- or one-criterion track.\",\n          \"type\": \"string\"\n        },\n        \"evidence_ref\": {\n          \"description\": \"Immutable receipt/URL/commit/job/review reference.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"observed_at\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        },\n        \"verifier_class\": {\n          \"enum\": [\n            \"external_state\",\n            \"command\",\n            \"review\",\n            \"operator\",\n            \"manual\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"verifier_class\",\n        \"evidence_ref\",\n        \"artifact_version\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"reopen_project_track\",\n    \"description\": \"Explicitly reopen a satisfied or cancelled track. Requires a reason, records the authenticated actor, increments the contract revision, and prevents old evidence from satisfying the new revision. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"governed_artifact_version\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"reason\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_project_track\",\n    \"description\": \"Satisfy a track with evidence — the ONLY way a track becomes satisfied (set_project_track rejects done/closed). Pass one evidence entry per declared acceptance criterion (criterion_id = the criterion text or c1, c2, …; omit when the track declares none). Each entry names an immutable handle: kind pr_merged | pr_head_review | review with subject_id 'owner/repo#233@<head sha>', or command / external_state / operator / manual with a job id, commit, or named decision. Head-bound evidence is invalidated automatically when the PR head moves. Use a stable idempotency_key per acceptance (retry-safe); pass expected_revision from get_situation to detect concurrent edits (409 on mismatch). Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"evidence\": {\n          \"items\": {\n            \"properties\": {\n              \"criterion_id\": {\n                \"type\": \"string\"\n              },\n              \"kind\": {\n                \"enum\": [\n                  \"pr_merged\",\n                  \"pr_head_review\",\n                  \"review\",\n                  \"command\",\n                  \"external_state\",\n                  \"operator\",\n                  \"manual\"\n                ],\n                \"type\": \"string\"\n              },\n              \"payload\": {\n                \"type\": \"object\"\n              },\n              \"subject_id\": {\n                \"description\": \"Immutable handle, e.g. 'lfglabs-dev/verity#233@20494801f6e2'.\",\n                \"type\": \"string\"\n              },\n              \"verifier\": {\n                \"description\": \"Who or what verified it (reviewer, check name, mission id).\",\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"kind\",\n              \"subject_id\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        },\n        \"expected_revision\": {\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"idempotency_key\",\n        \"evidence\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"invalidate_project_track_evidence\",\n    \"description\": \"Withdraw one piece of evidence on a track (receipt_id from get_situation / the track's receipts) with a reason. Appends an invalidate receipt; the track reopens if no other evidence stands. Use when a certification turned out wrong or the governed artifact changed in a way the watcher cannot see. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        },\n        \"receipt_id\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"track\",\n        \"receipt_id\",\n        \"reason\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project_grant\",\n    \"description\": \"Read your project's autonomy grant: merge authority (full | repo:… | review-first), budget per tick, parallel missions, and the structured PAUSED(pause_reason; resume_condition). This is the durable source of what you are authorized to do — it survives prompt rewrites. Read it at your first tick.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"set_project_grant\",\n    \"description\": \"Record the owner's autonomy grant for a project after they answer the setup questions: the normalized autonomy level, merge authority, budget, parallel missions, pause reason + machine-checkable resume condition, and the material-report bar. The project must already exist. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"autonomy_level\": {\n          \"description\": \"What the controller may do without asking: observe (report only), propose (escalate every act), act_reversible (act, but irreversible kinds — merge/abandon/delete/publish/deploy/force_push — still escalate), act_full.\",\n          \"enum\": [\n            \"observe\",\n            \"propose\",\n            \"act_reversible\",\n            \"act_full\"\n          ],\n          \"type\": \"string\"\n        },\n        \"budget_per_tick\": {\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"material_bar\": {\n          \"type\": \"string\"\n        },\n        \"merge_authority\": {\n          \"description\": \"full | repo:a,b | review-first\",\n          \"type\": \"string\"\n        },\n        \"parallel_missions\": {\n          \"type\": \"integer\"\n        },\n        \"pause_reason\": {\n          \"type\": \"string\"\n        },\n        \"resume_condition\": {\n          \"description\": \"A condition you can check yourself, e.g. 'FTDI device enumerates on spark-de79'.\",\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"add_project_steer\",\n    \"description\": \"Queue a one-off operator order for the project's next controller tick. Pending steers appear on get_situation / get_project and outrank “nothing to do”; acknowledge only handled IDs using update_project_status.consumed_steer_ids. This is not a grant — standing authority still uses set_project_grant. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"body\": {\n          \"description\": \"What the next tick must acknowledge and act on.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"body\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"record_project_decision\",\n    \"description\": \"Write to the project's decision ledger. Two uses: (1) declare an autonomous act BEFORE doing it (authority=granted, status=decided, kind, evidence with pr_url/mission_id) — if the response says coerced=true your grant does not cover it, treat it as an escalation and do NOT execute; (2) ask the owner a question (authority=escalation or just omit the new fields — the legacy shape still means 'ask'). Non-blocking either way. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"authority\": {\n          \"enum\": [\n            \"granted\",\n            \"escalation\"\n          ],\n          \"type\": \"string\"\n        },\n        \"evidence\": {\n          \"description\": \"Supporting links, e.g. {\\\"pr_url\\\": ..., \\\"mission_id\\\": ...}.\",\n          \"type\": \"object\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"description\": \"merge | dispatch | abandon | pause | resume | scope | budget | retry | ...\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"description\": \"The question for the owner, or the past-tense statement of the act ('Merged verity#2213').\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"enum\": [\n            \"decided\",\n            \"pending_user\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"question\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"answer_project_decision\",\n    \"description\": \"Resolve a pending owner escalation in a project's decision ledger with the owner's answer. Use only when relaying a decision the owner actually expressed. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"answer\": {\n          \"type\": \"string\"\n        },\n        \"at\": {\n          \"description\": \"The decision's 'at' timestamp key from get_project/record_project_decision.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"at\",\n        \"answer\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_project_tasks\",\n    \"description\": \"The project's roadmap: every board task planned under the project's boss missions, with status, dependencies, result digest, PR link, and worker mission. Read this to see what is done/running/failed across the whole project without walking individual mission boards.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"slug\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"plan_project_tasks\",\n    \"description\": \"Declare or revise project tracks. These rows are the only roadmap denominator. Re-planning preserves terminal lifecycle and current evidence; use explicit reopen for terminal work. Set position when the operator declares an exact sequence. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"tasks\": {\n          \"items\": {\n            \"properties\": {\n              \"acceptance_criteria\": {\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"depends_on\": {\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"position\": {\n                \"description\": \"Optional zero-based declarative order. Omission preserves an existing position or appends a new track.\",\n                \"minimum\": 0,\n                \"type\": \"integer\"\n              },\n              \"prompt\": {\n                \"description\": \"What a worker should actually do, if known.\",\n                \"type\": \"string\"\n              },\n              \"task_key\": {\n                \"description\": \"Stable kebab-case key, unique within the project.\",\n                \"type\": \"string\"\n              },\n              \"title\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"task_key\",\n              \"title\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"tasks\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_project_task\",\n    \"description\": \"Edit an open roadmap proposal (title, prompt, acceptance criteria, dependencies). Only proposals are editable — once a boss mission plans the key as a real board task, edits flow through that mission. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"acceptance_criteria\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"depends_on\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"task_key\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_project_task\",\n    \"description\": \"Cancel an open roadmap proposal. Board tasks already adopted by a boss mission are not touched — cancel those through the mission's own board. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"slug\",\n        \"task_key\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"link_mission_to_project\",\n    \"description\": \"Tag a mission as belonging to your project (and optionally a track), so it appears in the project's inventory. Optional writer=false persists read-only capability, including when no PR is attached; writer=true requests writer capability through the existing ownership checks. Capability or assignment changes require stopped, drained work; Pending work must be cancelled first and resumed on the same mission after the update. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"slug\": {\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"type\": \"string\"\n        },\n        \"writer\": {\n          \"description\": \"Explicit capability update. False persists read-only; true requests writer ownership. Omit to preserve existing behavior.\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"slug\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_workspaces\",\n    \"description\": \"List sandboxed.sh workspaces so new missions can target the right environment.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace\",\n    \"description\": \"Get the complete configuration and current build status of one sandboxed.sh workspace.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"workspace_id\": {\n          \"description\": \"Workspace UUID.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"workspace_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"create_workspace\",\n    \"description\": \"Create a sandboxed.sh workspace. A template always creates an isolated container and starts its build automatically; a host workspace requires a path inside the server working directory. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"distro\": {\n          \"type\": \"string\"\n        },\n        \"env_vars\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"object\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"init_script\": {\n          \"type\": \"string\"\n        },\n        \"mcps\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"mcps_replace_defaults\": {\n          \"type\": \"boolean\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Required for host workspaces; omit for the standard container path.\",\n          \"type\": \"string\"\n        },\n        \"plugins\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"shared_network\": {\n          \"type\": \"boolean\"\n        },\n        \"skills\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"tailscale_mode\": {\n          \"enum\": [\n            \"exit_node\",\n            \"tailnet_only\"\n          ],\n          \"type\": \"string\"\n        },\n        \"template\": {\n          \"description\": \"Workspace template name. Forces container type and starts a build.\",\n          \"type\": \"string\"\n        },\n        \"workspace_type\": {\n          \"description\": \"Defaults to host unless template is set.\",\n          \"enum\": [\n            \"host\",\n            \"container\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_workspace\",\n    \"description\": \"Update only the supplied fields of an existing workspace. Setting template changes the association but does not reapply template contents; use rebuild_workspace_from_template for that. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"config\": {\n          \"description\": \"Shallow-merged into freeform workspace config.\",\n          \"type\": \"object\"\n        },\n        \"config_profile\": {\n          \"description\": \"Empty string clears the profile.\",\n          \"type\": \"string\"\n        },\n        \"distro\": {\n          \"description\": \"Empty string clears the override.\",\n          \"type\": \"string\"\n        },\n        \"env_vars\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Replaces the workspace env map.\",\n          \"type\": \"object\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"init_script\": {\n          \"type\": \"string\"\n        },\n        \"init_scripts\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"mcps\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"mcps_replace_defaults\": {\n          \"type\": \"boolean\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"plugins\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"shared_network\": {\n          \"type\": \"boolean\"\n        },\n        \"skills\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"tailscale_mode\": {\n          \"enum\": [\n            \"exit_node\",\n            \"tailnet_only\"\n          ],\n          \"type\": \"string\"\n        },\n        \"template\": {\n          \"description\": \"Empty string clears the association.\",\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"workspace_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"delete_workspace\",\n    \"description\": \"Delete a sandboxed.sh workspace and its managed container data. Requires confirm=true; active missions that reference it are not deleted. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"confirm\": {\n          \"description\": \"Must be true to perform deletion.\",\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"workspace_id\",\n        \"confirm\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"list_workspace_templates\",\n    \"description\": \"List reusable sandboxed.sh workspace templates from the Library.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace_template\",\n    \"description\": \"Get a reusable workspace template. Sensitive values are redacted from the tool result.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"save_workspace_template\",\n    \"description\": \"Create or update a reusable workspace template. Existing templates are patch-updated: omitted fields are preserved, while supplied arrays/maps replace that field. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"distro\": {\n          \"type\": \"string\"\n        },\n        \"encrypted_keys\": {\n          \"description\": \"Env var keys to encrypt at rest.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"env_vars\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"object\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"init_script\": {\n          \"type\": \"string\"\n        },\n        \"init_scripts\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"mcps\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"mcps_replace_defaults\": {\n          \"type\": \"boolean\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"shared_network\": {\n          \"type\": \"boolean\"\n        },\n        \"skills\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"tailscale_mode\": {\n          \"enum\": [\n            \"exit_node\",\n            \"tailnet_only\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"delete_workspace_template\",\n    \"description\": \"Delete a reusable workspace template. Requires confirm=true and does not delete workspaces already created from it. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"confirm\": {\n          \"description\": \"Must be true to perform deletion.\",\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"confirm\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"rebuild_workspace_from_template\",\n    \"description\": \"Reapply the latest template definition to an existing container workspace, replacing template-controlled fields, then force-rebuild its container. Requires confirm=true because container state may be replaced. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"confirm\": {\n          \"description\": \"Must be true to force rebuild.\",\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"template\": {\n          \"description\": \"Optional template name; defaults to the workspace's current template.\",\n          \"type\": \"string\"\n        },\n        \"workspace_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"workspace_id\",\n        \"confirm\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"start_workspace_job\",\n    \"description\": \"Start a restart-safe long-running command in a workspace and return immediately with a durable job id. Supply exactly one of command or argv. Retries must reuse the same idempotency_key; a reused key cannot submit duplicate work. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"argv\": {\n          \"description\": \"Argument vector, safely shell-quoted. Mutually exclusive with command.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        \"command\": {\n          \"description\": \"Shell command. Mutually exclusive with argv.\",\n          \"type\": \"string\"\n        },\n        \"cwd\": {\n          \"description\": \"Working directory relative to the workspace root.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"resource_class\": {\n          \"description\": \"Scheduling hint such as lean_heavy, cpu, or io.\",\n          \"type\": \"string\"\n        },\n        \"timeout_secs\": {\n          \"description\": \"Absolute runtime limit. Default 7200 seconds, maximum 86400.\",\n          \"type\": \"integer\"\n        },\n        \"workspace_id\": {\n          \"description\": \"Workspace UUID. Defaults to the assistant default workspace.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_workspace_job\",\n    \"description\": \"Inspect a durable workspace job by id, including heartbeat, deadline, scope, exit status, and bounded stdout/stderr tails.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"job_id\": {\n          \"type\": \"string\"\n        },\n        \"tail_bytes\": {\n          \"description\": \"Maximum bytes from each log, default 16384, maximum 65536.\",\n          \"type\": \"integer\"\n        }\n      },\n      \"required\": [\n        \"job_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"cancel_workspace_job\",\n    \"description\": \"Idempotently request cancellation of a durable workspace job. Returns after cancellation is recorded; process teardown continues asynchronously. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_health\",\n    \"description\": \"Diagnose where a mission stands: live run state, stall severity, detected error signals (rate limit / auth / capacity / context-limit / network), suspected tool loops, the last assistant message, and a one-line recommendation. Use this first when babysitting a long-running mission — it summarizes 'where it is struggling' instead of making you read raw events. Includes goal_mode separately from mission_mode and a goal_objective preview of at most 1,000 characters plus a truncation ellipsis.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_mission_diagnostics\",\n    \"description\": \"Deep-dive a mission: recent tool calls, deduplicated result snippets, per-tool counts, repeated calls, and bounded error summaries. Use get_mission_events for raw receipts. Use when get_mission_health flags a problem and you need to see exactly what the model is doing.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"limit\": {\n          \"description\": \"Trace events to scan from the tail, default 80, max 300.\",\n          \"type\": \"integer\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"update_mission_settings\",\n    \"description\": \"Change a mission's run settings for its NEXT turn: switch backend (claudecode/codex/opencode/antigravity/grok/vibe), model, reasoning effort, fast mode, or agent. On a failed or interrupted mission the server resumes it on the new settings automatically (resume_queued in the response) — a handoff is one call, no separate resume_mission. Applies between turns — the mission must be idle (awaiting_user/acknowledged/interrupted/failed), not actively running. If it is running, cancel_mission first (or wait), then update, then send_message_to_mission or resume_mission to kick the next turn. model_effort applies to claudecode/codex; fast_mode applies only to Codex GPT-5.6/5.5/5.4 and consumes ChatGPT credits faster. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"agent\": {\n          \"description\": \"Agent name. Omission preserves it on the same backend and clears it on a backend switch. Empty string clears it.\",\n          \"type\": \"string\"\n        },\n        \"backend\": {\n          \"enum\": [\n            \"opencode\",\n            \"claudecode\",\n            \"codex\",\n            \"grok\",\n            \"antigravity\",\n            \"vibe\"\n          ],\n          \"type\": \"string\"\n        },\n        \"config_profile\": {\n          \"type\": \"string\"\n        },\n        \"fast_mode\": {\n          \"description\": \"Enable or disable Codex fast mode for future turns. Only backend=codex with GPT-5.6/5.5/5.4.\",\n          \"type\": \"boolean\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"model_effort\": {\n          \"enum\": [\n            \"low\",\n            \"medium\",\n            \"high\",\n            \"xhigh\",\n            \"max\"\n          ],\n          \"type\": \"string\"\n        },\n        \"model_override\": {\n          \"description\": \"Model id. Empty string clears it. When backend changes this is reset unless set explicitly.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"resume_mission\",\n    \"description\": \"Resume an interrupted, blocked or failed mission. Bound Codex missions reattach to the same native thread, cwd, HOME and account; existing native goals preserve their objective, token budget and accumulated usage. Grok resumes its recorded native session; a first handoff creates a Grok session while preserving other harness identities. For a mission parked in awaiting_user or acknowledged, send_message_to_mission wakes it on the same id and is the normal choice. Pass `content` as the exact current steering input; on a bound native goal it steers that goal's turn. A new Codex /goal objective must be at most 4000 Unicode characters; oversized objectives are rejected without truncation. Without `content`, persisted Codex goal missions resume the full stored /goal objective; other missions receive the default continue-where-you-left-off prompt. Native blocked/paused/usageLimited/budgetLimited stops park as blocked with terminal_reason=native_goal_stopped after the final response drains; they never mean goal completion. Resolve the reported stop before resuming. codex_continuity_required or native_continuity_required means native identity/history or a tool outcome requires reconciliation: do not repeat identical resumes, change accounts, or assume a fresh thread or reset budget. Queued steering retains its durable order; unconfirmed native delivery is reported explicitly. For existing work with excluded/collaborating PR references, read get_mission and pass continue_identity with the exact stored project, track and github_pr (null if unset). For different work use explicit github_pr/track identity updates instead; ownership checks still apply. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"clean_workspace\": {\n          \"description\": \"Wipe the work directory before resuming. Rarely needed; default false.\",\n          \"type\": \"boolean\"\n        },\n        \"content\": {\n          \"description\": \"Optional steering message used as the resume turn's prompt.\",\n          \"type\": \"string\"\n        },\n        \"continue_identity\": {\n          \"additionalProperties\": false,\n          \"description\": \"Trusted caller assertion, not proof of unchanged objective. Assert this turn continues the mission's existing work. Copy the exact stored project, track and github_pr (explicit null if unset) from get_mission. Prose may mention excluded or collaborating PRs. Cannot accompany title/track/github_pr updates; never use for different work. Does not grant PR ownership.\",\n          \"properties\": {\n            \"github_pr\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"project\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"track\": {\n              \"minLength\": 1,\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"project\",\n            \"track\",\n            \"github_pr\"\n          ],\n          \"type\": \"object\"\n        },\n        \"github_pr\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"mission_id\": {\n          \"description\": \"Full mission UUID.\",\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"description\": \"Explicit identity title update. Cannot accompany continue_identity.\",\n          \"type\": \"string\"\n        },\n        \"track\": {\n          \"description\": \"Explicit retask identity update; empty string clears. Omit to preserve.\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"mission_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"get_backend_auth_status\",\n    \"description\": \"Report which backends are actually usable from the backend's credential store and provider targeting. Use this instead of guessing from shell env vars or CLI login checks.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"backend\": {\n          \"description\": \"Optional single backend to inspect. If omitted, returns all common backends.\",\n          \"enum\": [\n            \"claudecode\",\n            \"codex\",\n            \"opencode\",\n            \"grok\",\n            \"antigravity\",\n            \"vibe\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"plan_tasks\",\n    \"description\": \"PREFERRED orchestration tool. Register tasks on this mission's task board. The server-side scheduler then owns everything mechanical: it spawns a worker mission for every dependency-satisfied task while capacity allows, retries failures once, and MESSAGES YOU A DIGEST as each task settles. You never create workers, wait, or poll. Specify each task by its OUTCOME, not its procedure: acceptance_criteria + verification_command are the contract (the weakest testable conditions that define success — any approach satisfying them is an acceptable delivery); the prompt supplies scope, absolute paths, and context, and its suggested approach is advisory. Each task needs: task_key (stable, unique), title, prompt, backend (codex/opencode/grok — never claudecode), acceptance_criteria + verification_command (strongly recommended; tasks without either get a spec_warnings entry), and optionally risk_class (high = never retried silently), model_override/model_effort, depends_on (keys of tasks that must settle successfully first — unknown keys park the task and raise unresolvable_deps), and worktree {path, branch, base} for an isolated checkout (created here, before registration). Re-calling with an existing key updates the task while it is still pending. After planning: END YOUR TURN — digests will wake you. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"tasks\": {\n          \"items\": {\n            \"properties\": {\n              \"acceptance_criteria\": {\n                \"description\": \"Objective, testable conditions that define success — the weakest set that still guarantees the outcome. Delivered to the worker as the authoritative contract\",\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"backend\": {\n                \"description\": \"codex | opencode | grok (never claudecode)\",\n                \"type\": \"string\"\n              },\n              \"depends_on\": {\n                \"description\": \"task_keys that must settle successfully or be accepted first\",\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"type\": \"array\"\n              },\n              \"model_effort\": {\n                \"description\": \"low | medium | high | xhigh | max (codex)\",\n                \"type\": \"string\"\n              },\n              \"model_override\": {\n                \"description\": \"Exact account-supported model ID. For Codex Terra use gpt-5.6-terra with medium effort. Never invent variants such as gpt-5.5-sol.\",\n                \"type\": \"string\"\n              },\n              \"prompt\": {\n                \"description\": \"Worker prompt: exact scope, absolute paths, context. Suggested approach is advisory — the acceptance criteria define success\",\n                \"type\": \"string\"\n              },\n              \"risk_class\": {\n                \"description\": \"low | normal (default) | high. high = a failed attempt is never retried silently; it settles for your review\",\n                \"type\": \"string\"\n              },\n              \"task_key\": {\n                \"description\": \"Stable unique key on this board (e.g. 'p3-nonce')\",\n                \"type\": \"string\"\n              },\n              \"title\": {\n                \"type\": \"string\"\n              },\n              \"verification_command\": {\n                \"description\": \"Command whose success verifies the task; the worker must run it before DELIVERED\",\n                \"type\": \"string\"\n              },\n              \"working_directory\": {\n                \"description\": \"Worker cwd; superseded by worktree.path if a worktree is given\",\n                \"type\": \"string\"\n              },\n              \"worktree\": {\n                \"properties\": {\n                  \"base\": {\n                    \"description\": \"Base branch/commit (default HEAD)\",\n                    \"type\": \"string\"\n                  },\n                  \"branch\": {\n                    \"type\": \"string\"\n                  },\n                  \"path\": {\n                    \"description\": \"Absolute worktree path (inside the workspace)\",\n                    \"type\": \"string\"\n                  },\n                  \"repo_path\": {\n                    \"description\": \"Repo owning the worktree (auto-detected if omitted)\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\",\n                  \"branch\"\n                ],\n                \"type\": \"object\"\n              }\n            },\n            \"required\": [\n              \"task_key\",\n              \"title\",\n              \"prompt\",\n              \"backend\"\n            ],\n            \"type\": \"object\"\n          },\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"tasks\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"board_status\",\n    \"description\": \"Current task board: every task with status (pending/running/settled/accepted/failed/cancelled), outcome, worker mission id, digest, plus utilization counters and unresolvable_deps (tasks parked forever on a depends_on key that doesn't exist — fix by re-registering via plan_tasks). Cheap snapshot — use instead of list_worker_missions/get_worker_status for board work.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {},\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"review_task\",\n    \"description\": \"Full review payload for a board task: the task record (prompt, digest, notes) plus the tail of the worker mission's conversation. Use before accept_task/reject_task when the digest alone isn't enough to judge. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"history_limit\": {\n          \"description\": \"Worker history entries to include (default 6)\",\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"description\": \"Task UUID (alternative)\",\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"description\": \"Task key on this board (preferred)\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"accept_task\",\n    \"description\": \"Accept a settled task's result (terminal verdict). Unblocks nothing extra — successful settles already unblock dependents — but records your judgment and clears the awaiting-verdict queue. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"reject_task\",\n    \"description\": \"Reject a settled (or failed) task with feedback. The worker mission is resumed with your feedback so it keeps its context; if the worker is gone the task is re-queued with the feedback appended to its prompt. Feedback should be the MINIMAL added constraint: a concrete counterexample or a new acceptance criterion that excludes the observed failure — not a prescription of how to redo the work. Judge results on whether they satisfy the acceptance criteria/verification, never on whether the worker followed the approach you imagined. You'll get a fresh digest when it settles again. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"feedback\": {\n          \"description\": \"What is wrong and what to change — delivered verbatim to the worker\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"task_id\": {\n          \"type\": \"string\"\n        },\n        \"task_key\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"feedback\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"deploy_sandboxed_sh\",\n    \"description\": \"Build and hot-swap one Sandboxed.sh backend with safety rails.\\nTargeting is explicit:\\n• Omit target_environment to deploy the backend API this mission is connected to.\\n• Set target_environment=\\\"dev\\\" to deploy sandboxed-sh-dev via localhost:3002.\\n• Set target_environment=\\\"prod\\\" to deploy sandboxed-sh-prod via localhost:3000.\\nThe backend refuses if the request reaches a service different from the requested target.\\n• Self-protection: refuses by default if your own mission lives on the service being restarted (passing force=true acknowledges that your turn will be SIGTERM'd).\\n• Debounce: refuses if another deploy fired in the last few minutes (force=true overrides).\\n• Atomic install with .pre-deploy-<sha> backups + detached restart so the SSE response flushes before the service dies. If the orchestrator-mcp install fails, the main binary swap is rolled back so the system is never in a half-applied state.\\nReplaces calling `systemctl restart` directly from a shell. Returns the deployed commit sha on success. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"force\": {\n          \"default\": false,\n          \"description\": \"Bypass self-protection AND debounce. Only set this when you've explicitly decided the restart is worth killing your own turn / breaking the cooldown.\",\n          \"type\": \"boolean\"\n        },\n        \"git_ref\": {\n          \"description\": \"Optional git ref (tag/branch/sha) to check out before building. Omit to deploy whatever the local repo currently has checked out.\",\n          \"type\": \"string\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"repo_path\": {\n          \"description\": \"Override the server's configured source repo path. Required when your build artifact lives outside the default location (e.g. a worktree at /opt/sandboxed-sh-<name>/).\",\n          \"type\": \"string\"\n        },\n        \"skip_build\": {\n          \"default\": false,\n          \"description\": \"Skip the cargo build step and assume <repo_path>/target/debug/sandboxed-sh and orchestrator-mcp are already current. Useful when the build was done elsewhere.\",\n          \"type\": \"boolean\"\n        },\n        \"target_environment\": {\n          \"description\": \"Explicit environment to deploy. Omit to deploy the backend API this mission is connected to. Use dev for sandboxed-sh-dev on localhost:3002 and prod for sandboxed-sh-prod on localhost:3000.\",\n          \"enum\": [\n            \"dev\",\n            \"prod\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"delay_seconds\": {\n          \"maximum\": 3600,\n          \"minimum\": 60,\n          \"type\": \"integer\"\n        },\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"delay_seconds\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"schedule_job_wakeup\",\n    \"description\": \"Schedule one durable continuation of this authenticated mission. Core owns the timer and delivery; end your turn after confirming the action receipt. A time wake-up replaces this mission's previous time wake-up. Never also start a native timer for the same request. Returns an action receipt immediately. Read its result with get_action; retry the same logical request with the same key.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"idempotency_key\": {\n          \"description\": \"Stable key for this logical operation. Reuse after a lost response; never change its arguments.\",\n          \"maxLength\": 200,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"job_id\": {\n          \"format\": \"uuid\",\n          \"type\": \"string\"\n        },\n        \"prompt\": {\n          \"description\": \"Instruction to deliver on resumption.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"description\": \"Short explanation shown in Orb.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"prompt\",\n        \"reason\",\n        \"job_id\",\n        \"idempotency_key\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_search_knowledge\",\n    \"description\": \"Search curated Hindsight knowledge pages (`thomas` or `ppl` bank) via Core's governed memory broker. Returns matching page titles, paths, and excerpts in one round-trip without exposing raw API keys to the worker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` for general personal/project context, `ppl` for people/relationships; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"limit\": {\n          \"description\": \"Maximum results to return (1..=25, default 10).\",\n          \"maximum\": 25,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Search query keywords or phrase.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_page\",\n    \"description\": \"Read a full curated Hindsight knowledge page by `path` (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Knowledge page path returned by `memory_search_knowledge` or `memory_get_knowledge_tree`.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\"\n      ],\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_get_knowledge_tree\",\n    \"description\": \"List the curated Hindsight knowledge directory tree (`thomas` or `ppl` bank) via Core's governed memory broker.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Knowledge bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Optional subtree prefix to inspect.\",\n          \"maxLength\": 500,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"type\": \"object\"\n    }\n  },\n  {\n    \"name\": \"memory_recall\",\n    \"description\": \"Recall raw episodic memories from Hindsight (`thomas` or `ppl` bank) when curated knowledge pages (`memory_search_knowledge`) do not yet cover a topic.\",\n    \"inputSchema\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"bank\": {\n          \"description\": \"Memory bank (`thomas` or `ppl`; defaults to `thomas`).\",\n          \"enum\": [\n            \"thomas\",\n            \"ppl\"\n          ],\n          \"type\": \"string\"\n        },\n        \"max_tokens\": {\n          \"description\": \"Token budget for recalled memories (1..=8192, default 4096).\",\n          \"maximum\": 8192,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        \"query\": {\n          \"description\": \"Natural-language recall query.\",\n          \"maxLength\": 1000,\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"query\"\n      ],\n      \"type\": \"object\"\n    }\n  }\n]"

def catalogPrettyJsonForRole (role : String) : Option String :=
  match role with
  | "executor" => some executorCatalogPrettyJson
  | "coordinator" => some coordinatorCatalogPrettyJson
  | "operator" => some operatorCatalogPrettyJson
  | _ => none

