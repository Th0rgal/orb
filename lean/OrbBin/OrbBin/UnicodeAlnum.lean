def isUnicodeAlnum (c : Char) : Bool := Id.run do
  let cp := c.toNat.toUInt32
  if cp < 0x80 then
    return c.isAlphanum
  let mut lo : Nat := 0
  let mut hi : Nat := alnumRanges.size
  while lo < hi do
    let mid := (lo + hi) / 2
    let entry := alnumRanges[mid]!
    let rLo := (entry >>> 32).toUInt32
    let rHi := (entry &&& 0xFFFFFFFF).toUInt32
    if cp < rLo then
      hi := mid
    else if cp > rHi then
      lo := mid + 1
    else
      return true
  return false

def toUnicodeLower (c : Char) : Char := Id.run do
  let cp := c.toNat.toUInt32
  if cp < 0x80 then
    return c.toLower
  let mut lo : Nat := 0
  let mut hi : Nat := lowerMap.size
  while lo < hi do
    let mid := (lo + hi) / 2
    let entry := lowerMap[mid]!
    let k := (entry >>> 32).toUInt32
    let v := (entry &&& 0xFFFFFFFF).toUInt32
    if cp < k then
      hi := mid
    else if cp > k then
      lo := mid + 1
    else
      return Char.ofNat v.toNat
  return c

end OrbBin.UnicodeAlnum
