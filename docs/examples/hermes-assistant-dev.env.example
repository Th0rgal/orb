# Example environment for a dev Hermes assistant service.
# Copy to a host-owned secret path such as /etc/sandboxed-sh/hermes-assistant-dev.env
# and fill in the values on the deployment host. Do not commit the real file.

HOME=/var/lib/hermes-assistant-dev
HERMES_HOME=/var/lib/hermes-assistant-dev
HERMES_ACCEPT_HOOKS=1
HERMES_INFERENCE_PROVIDER=custom

# Sandboxed.sh control plane used by the scoped MCP client.
SANDBOXED_MCP_API_URL=https://agent-backend-dev.thomas.md
# Provision using scripts/migrate_unified_mcp.py. This private file contains
# a renewable mcp1. session, never an owner JWT or Core signing secret.
SANDBOXED_MCP_TOKEN_FILE=/var/lib/hermes-assistant-dev/mcp-credential

# Sandboxed.sh OpenAI-compatible model proxy for Hermes.
# Hermes custom endpoints use the OpenAI-compatible env names when config.yaml
# points the model at ${OPENAI_BASE_URL} and ${OPENAI_API_KEY}.
OPENAI_BASE_URL=https://agent-backend-dev.thomas.md/v1
OPENAI_API_KEY=
HERMES_ASSISTANT_MODEL=builtin/smart

# Messaging gateway secrets belong to Hermes. These names are consumed by the
# Hermes Telegram gateway.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Dev-only escape hatch when the imported gateway has an empty allowlist.
# Do not use this in prod; set TELEGRAM_ALLOWED_USERS instead.
# GATEWAY_ALLOW_ALL_USERS=true

# Stdio MCP bridge exposed by this repository.
HERMES_ASSISTANT_MCP_COMMAND=/usr/local/bin/sandboxed-mcp-dev
