# Example Hermes config.yaml for the sandboxed.sh Assistant runtime.
# Install as /var/lib/hermes-assistant-dev/config.yaml or under the HERMES_HOME
# you choose for the service.

model:
  provider: custom
  default: ${HERMES_ASSISTANT_MODEL}
  base_url: ${OPENAI_BASE_URL}
  api_key: ${OPENAI_API_KEY}
  api_mode: chat_completions

terminal:
  # Keep Hermes' own shell/tool execution scoped to the assistant workspace.
  # Sandboxed mission work should go through sandboxed-mcp.
  backend: local
  cwd: /var/lib/hermes-assistant-dev/workspace

mcp_servers:
  sandboxed_assistant:
    command: ${HERMES_ASSISTANT_MCP_COMMAND}
    args: [--profile, coordinator]
    env:
      SANDBOXED_MCP_API_URL: ${SANDBOXED_MCP_API_URL}
      SANDBOXED_MCP_TOKEN_FILE: ${SANDBOXED_MCP_TOKEN_FILE}
    # Mutations return durable receipts; follow them with get_action.
    timeout: 60
    connect_timeout: 30
    tools:
      # The coordinator catalogue is supplied by Core. Do not copy a list
      # here; migrate_unified_mcp.py can pin the installed catalogue at cutover.
      prompts: false
      resources: false

display:
  platforms:
    telegram:
      tool_progress: off
      cleanup_progress: true
