[Unit]
Description=Orb Control Plane (Dev/Staging, formerly sandboxed-sh-dev / assistant-mcp-dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=90
TimeoutStartSec=300
WorkingDirectory=/var/lib/sandboxed-sh-dev
EnvironmentFile=-/etc/orb/core-dev.env
EnvironmentFile=-/etc/sandboxed-sh/dev.env
ExecStart=/usr/local/bin/sandboxed-sh-dev
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
Alias=sandboxed-sh-dev.service assistant-mcp-dev.service
