[Unit]
Description=Orb Control Plane (Production, formerly sandboxed-sh-prod / assistant-mcp)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=90
TimeoutStartSec=300
WorkingDirectory=/var/lib/sandboxed-sh
EnvironmentFile=/etc/orb/environments/core.env
EnvironmentFile=/etc/orb/environments/prod.env
ExecStartPre=/usr/local/libexec/orb-env check --base /etc/orb/environments/core.env --overlay /etc/orb/environments/prod.env
ExecStart=/usr/local/bin/orb-core
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
Alias=sandboxed-sh-prod.service assistant-mcp.service
