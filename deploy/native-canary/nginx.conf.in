worker_processes 1;
pid /run/orb-native-tests-tls/nginx.pid;
error_log stderr warn;
events {}
http {
    access_log off;
    client_body_temp_path /run/orb-native-tests-tls/body;
    proxy_temp_path /run/orb-native-tests-tls/proxy;
    fastcgi_temp_path /run/orb-native-tests-tls/fastcgi;
    scgi_temp_path /run/orb-native-tests-tls/scgi;
    uwsgi_temp_path /run/orb-native-tests-tls/uwsgi;
    server {
        listen @WORKER_MESH_IP@:13443 ssl;
        client_max_body_size 128m;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /run/credentials/orb-native-tests-tls.service/worker.pem;
        ssl_certificate_key /run/credentials/orb-native-tests-tls.service/worker.key;
        allow @CORE_MESH_IP@;
        deny all;
        location / {
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 1h;
            proxy_pass http://127.0.0.1:13088;
        }
    }
}
