{
  "version": 1,
  "description": "Cross-client projection invariants generated and verified by the Lean 4 formal kernel (lean/Orb/Kernel.lean & lean/Orb/Spec.lean): orb_workfold_step, orb_taskcard_step, orb_sidebar_visibility, orb_pr_gate_step, orb_turn_summary_step, orb_usage_limit_status, orb_relative_time_bucket, and orb_transcript_patch_step.",
  "workfold_cases": [
    {
      "name": "narration text between tools folds into WorkFold",
      "input": {
        "is_text": true,
        "cumulative": false,
        "non_empty": true,
        "tool_ahead": true,
        "fold_has_tool": false,
        "next_is_tool": true
      },
      "expected": {
        "fold": true,
        "next_fold_has_tool": false
      }
    },
    {
      "name": "final answer after last tool stays visible top-level",
      "input": {
        "is_text": true,
        "cumulative": false,
        "non_empty": true,
        "tool_ahead": false,
        "fold_has_tool": true,
        "next_is_tool": false
      },
      "expected": {
        "fold": false,
        "next_fold_has_tool": false
      }
    },
    {
      "name": "cumulative producer bubble is never folded as narration",
      "input": {
        "is_text": true,
        "cumulative": true,
        "non_empty": true,
        "tool_ahead": true,
        "fold_has_tool": true,
        "next_is_tool": true
      },
      "expected": {
        "fold": false,
        "next_fold_has_tool": false
      }
    },
    {
      "name": "text next to orchestration tool alone without prior work fold stays top-level",
      "input": {
        "is_text": true,
        "cumulative": false,
        "non_empty": true,
        "tool_ahead": true,
        "fold_has_tool": false,
        "next_is_tool": false
      },
      "expected": {
        "fold": false,
        "next_fold_has_tool": false
      }
    }
  ],
  "taskcard_cases": [
    {
      "name": "running turn is live",
      "input": {
        "ended": false,
        "all_done_or_cancelled": false,
        "outcome_finished": false,
        "has_open_tasks": true
      },
      "expected": {
        "state": "live",
        "mark_open_stale": false,
        "clear_in_progress": false
      }
    },
    {
      "name": "ended turn with all tasks completed or cancelled is done",
      "input": {
        "ended": true,
        "all_done_or_cancelled": true,
        "outcome_finished": true,
        "has_open_tasks": false
      },
      "expected": {
        "state": "done",
        "mark_open_stale": false,
        "clear_in_progress": false
      }
    },
    {
      "name": "ended turn with final answer and open tasks is stale (not updated), never stopped",
      "input": {
        "ended": true,
        "all_done_or_cancelled": false,
        "outcome_finished": true,
        "has_open_tasks": true
      },
      "expected": {
        "state": "stale",
        "mark_open_stale": true,
        "clear_in_progress": true
      }
    },
    {
      "name": "ended turn interrupted before final answer is stopped",
      "input": {
        "ended": true,
        "all_done_or_cancelled": false,
        "outcome_finished": false,
        "has_open_tasks": true
      },
      "expected": {
        "state": "stopped",
        "mark_open_stale": false,
        "clear_in_progress": true
      }
    }
  ],
  "sidebar_visibility_cases": [
    {
      "name": "archived parent with visible descendant stays in main tree and out of archive-only list",
      "input": {
        "is_archived": true,
        "has_visible_descendant": true,
        "is_working": false,
        "is_selected": false,
        "is_superseded": false,
        "ancestor_superseded": false
      },
      "expected": {
        "show_in_main_tree": true,
        "show_in_archive_only": false
      }
    },
    {
      "name": "archived mission without visible descendant goes to archive-only list",
      "input": {
        "is_archived": true,
        "has_visible_descendant": false,
        "is_working": false,
        "is_selected": false,
        "is_superseded": false,
        "ancestor_superseded": false
      },
      "expected": {
        "show_in_main_tree": false,
        "show_in_archive_only": true
      }
    },
    {
      "name": "superseded stopped mission is hidden unless selected or still running",
      "input": {
        "is_archived": false,
        "has_visible_descendant": false,
        "is_working": false,
        "is_selected": false,
        "is_superseded": true,
        "ancestor_superseded": false
      },
      "expected": {
        "show_in_main_tree": false,
        "show_in_archive_only": false
      }
    },
    {
      "name": "superseded mission that is still working stays visible in main tree",
      "input": {
        "is_archived": false,
        "has_visible_descendant": false,
        "is_working": true,
        "is_selected": false,
        "is_superseded": true,
        "ancestor_superseded": true
      },
      "expected": {
        "show_in_main_tree": true,
        "show_in_archive_only": false
      }
    },
    {
      "name": "superseded mission that is explicitly selected stays visible in main tree",
      "input": {
        "is_archived": false,
        "has_visible_descendant": false,
        "is_working": false,
        "is_selected": true,
        "is_superseded": true,
        "ancestor_superseded": false
      },
      "expected": {
        "show_in_main_tree": true,
        "show_in_archive_only": false
      }
    }
  ],
  "pr_gate_cases": [
    {
      "name": "head drift since worker turn outranks external action and check gates",
      "input": {
        "merged": false,
        "draft": false,
        "closed": false,
        "exact_head": false,
        "action_required": true,
        "blocked": false,
        "behind": false,
        "conflicting": false,
        "checks_green": true,
        "workflows_green": true
      },
      "expected": {
        "code": 3,
        "recommendation": "head_changed_since_worker"
      }
    },
    {
      "name": "exact head with green checks and workflows is ready for review or merge",
      "input": {
        "merged": false,
        "draft": false,
        "closed": false,
        "exact_head": true,
        "action_required": false,
        "blocked": false,
        "behind": false,
        "conflicting": false,
        "checks_green": true,
        "workflows_green": true
      },
      "expected": {
        "code": 8,
        "recommendation": "ready_for_review_or_merge"
      }
    },
    {
      "name": "exact head behind base needs update before conflict or check evaluation",
      "input": {
        "merged": false,
        "draft": false,
        "closed": false,
        "exact_head": true,
        "action_required": false,
        "blocked": false,
        "behind": true,
        "conflicting": true,
        "checks_green": true,
        "workflows_green": true
      },
      "expected": {
        "code": 6,
        "recommendation": "needs_update_with_base"
      }
    }
  ],
  "turn_summary_cases": [
    {
      "name": "in_progress task settles to pending when turn ends",
      "input": {
        "raw_status": 1,
        "turn_ended": true,
        "all_closed": false,
        "turn_outcome_finished": true
      },
      "expected": {
        "normalized_status": 0,
        "is_done": false,
        "is_active": false,
        "card_state": 2
      }
    },
    {
      "name": "completed task stays done and active task stays active while turn is live",
      "input": {
        "raw_status": 1,
        "turn_ended": false,
        "all_closed": false,
        "turn_outcome_finished": false
      },
      "expected": {
        "normalized_status": 1,
        "is_done": false,
        "is_active": true,
        "card_state": 0
      }
    }
  ],
  "transcript_patch_cases": [
    {
      "name": "incremental SSE chunk fold matches batch transcript projection",
      "chunk1": [
        { "event_kind": 0, "delta_len": 12 },
        { "event_kind": 0, "delta_len": 8 }
      ],
      "chunk2": [
        { "event_kind": 1, "delta_len": 25 },
        { "event_kind": 2, "delta_len": 0 },
        { "event_kind": 0, "delta_len": 14 }
      ],
      "expected": {
        "final_len": 14,
        "final_seq": 5
      }
    }
  ]
}
