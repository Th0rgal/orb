        "https://agent-backend.thomas.md",
        "https://orbcore.thomas.md",
        "https://agent-backend.nico-best-pc-ever.ovh"
      ]
    },
    {
      "name": "direct_ovh_primary_falls_back_to_cloudflare_then_orbcore",
      "configured_url": "https://agent-backend.nico-best-pc-ever.ovh",
      "expected": [
        "https://agent-backend.nico-best-pc-ever.ovh",
        "https://agent-backend.thomas.md",
        "https://orbcore.thomas.md"
      ]
    },
    {
      "name": "self_hosted_custom_origin_never_leaks_to_hosted_failovers",
      "configured_url": "https://orb.internal.example.com:8443/",
      "expected": [
        "https://orb.internal.example.com:8443"
      ]
    }
  ]
